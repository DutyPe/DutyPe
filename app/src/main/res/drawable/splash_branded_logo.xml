<?xml version="1.0" encoding="utf-8"?>
<!--
    DutyPe splash screen branded logo.

    Rendered by Android 12+ splash screen API as `windowSplashScreenAnimatedIcon`.
    Canvas is 288dp x 288dp. The Android 12+ splash API masks the icon to the
    inner ~192dp circular safe zone — keep all visible content within
    viewport coords 48..240 (inner 192 of the 288 canvas).

    Design:
      • Soft amber-to-orange gradient circle as the brand mark background.
      • Crisp white "D" monogram centered in the circle.
      • Compact "DutyPe" wordmark below the mark.

    All paths are pure vector geometry so the result stays sharp at every
    density — no bitmap/text-rendering artefacts on the splash.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- Brand mark: gradient-filled circle (safe zone) -->
    <path android:pathData="M144,52 m-72,0 a72,72 0 1,0 144,0 a72,72 0 1,0 -144,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="72" android:startY="-20"
                android:endX="216"  android:endY="124"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFB347" />
                <item android:offset="1.0" android:color="#F97316" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner highlight ring (subtle glossy edge) -->
    <path
        android:pathData="M144,52 m-66,0 a66,66 0 1,0 132,0 a66,66 0 1,0 -132,0"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- "D" monogram, centered inside the brand mark.
         Outer rounded-rectangle "D" shape with a hollow notch. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M112,16 L142,16
                         C168,16 188,34 188,52
                         C188,70 168,88 142,88
                         L112,88 Z
                         M126,30 L126,74
                         L142,74
                         C160,74 174,64 174,52
                         C174,40 160,30 142,30 Z" />

    <!-- Wordmark "DutyPe" below the mark.
         Each letter is a path; designed to look like a clean geometric
         sans-serif at small sizes. Stays within the 192dp visible width. -->

    <!-- D -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M64,168 L78,168
                         C90,168 98,176 98,188
                         C98,200 90,208 78,208
                         L64,208 Z
                         M70,174 L70,202 L78,202
                         C86,202 92,196 92,188
                         C92,180 86,174 78,174 Z" />

    <!-- u -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M104,180 L110,180 L110,198
                         C110,202 113,205 117,205
                         C121,205 124,202 124,198
                         L124,180 L130,180 L130,208 L124,208 L124,205
                         C122,207 119,209 116,209
                         C109,209 104,204 104,198 Z" />

    <!-- t -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M137,172 L143,172 L143,180 L150,180 L150,185
                         L143,185 L143,200
                         C143,203 144,205 147,205 L150,205 L150,209 L146,209
                         C141,209 137,206 137,200 L137,185 L132,185 L132,180 L137,180 Z" />

    <!-- y -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M155,180 L161,180 L168,200 L175,180 L181,180
                         L171,209 C170,213 168,215 164,215 L161,215
                         L161,210 L163,210 C165,210 166,209 166,207
                         L167,205 Z" />

    <!-- P (with brand orange to echo the mark) -->
    <path
        android:fillColor="#F97316"
        android:pathData="M188,168 L202,168
                         C212,168 218,174 218,182
                         C218,190 212,196 202,196
                         L194,196 L194,208 L188,208 Z
                         M194,174 L194,190 L202,190
                         C208,190 212,187 212,182
                         C212,177 208,174 202,174 Z" />

    <!-- e -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M222,194
                         C222,186 228,180 235,180
                         C242,180 248,186 248,194
                         L248,196 L228,196
                         C229,201 232,205 236,205
                         C239,205 241,204 243,202 L246,205
                         C243,208 240,209 236,209
                         C228,209 222,202 222,194 Z
                         M228,191 L242,191
                         C241,187 239,185 235,185
                         C231,185 229,187 228,191 Z" />
</vector>
