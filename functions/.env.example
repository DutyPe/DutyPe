# Copy to functions/.env (never commit the real file). Used by Cloud Functions at deploy time.

# Azure OpenAI — DutyPe AI and voice job posting (preferred over Gemini when set)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=dutype-chat

# Azure Cosmos DB — in-app feedback and DutyPe AI logs
AZURE_COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=dutype

# Gemini — optional fallback when Azure OpenAI is not set
GEMINI_API_KEY=
