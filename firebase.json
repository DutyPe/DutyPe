{
  "firestore": {
    "indexes": "firestore.indexes.json",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "source": "web",
    "frameworksBackend": {
      "region": "asia-east1",
      "memory": "512MiB",
      "minInstances": 0,
      "maxInstances": 5,
      "concurrency": 80,
      "secrets": ["AZURE_COSMOS_KEY"]
    },
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/ads.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/app-ads.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          }
        ]
      },
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          }
        ]
      },
      {
        "source": "/app/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/legal/privacy",
        "destination": "/privacy",
        "type": 301
      },
      {
        "source": "/legal/terms",
        "destination": "/terms",
        "type": 301
      },
      {
        "source": "/legal/refund",
        "destination": "/refund",
        "type": 301
      },
      {
        "source": "/legal/safety",
        "destination": "/safety",
        "type": 301
      },
      {
        "source": "/legal/contact",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/legal/account-deletion",
        "destination": "/accountdeletion",
        "type": 301
      },
      {
        "source": "/account-deletion",
        "destination": "/accountdeletion",
        "type": 301
      },
      {
        "source": "/delete-account",
        "destination": "/accountdeletion",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/jobs/index.html",
        "destination": "/jobs",
        "type": 301
      },
      {
        "source": "/worker/index.html",
        "destination": "/worker",
        "type": 301
      },
      {
        "source": "/employer/index.html",
        "destination": "/employer",
        "type": 301
      },
      {
        "source": "/privacy.html",
        "destination": "/privacy",
        "type": 301
      },
      {
        "source": "/terms.html",
        "destination": "/terms",
        "type": 301
      },
      {
        "source": "/refund.html",
        "destination": "/refund",
        "type": 301
      },
      {
        "source": "/safety.html",
        "destination": "/safety",
        "type": 301
      },
      {
        "source": "/contact.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/faq.html",
        "destination": "/faq",
        "type": 301
      },
      {
        "source": "/refer.html",
        "destination": "/refer",
        "type": 301
      },
      {
        "source": "/worker.html",
        "destination": "/worker",
        "type": 301
      },
      {
        "source": "/employer.html",
        "destination": "/employer",
        "type": 301
      },
      {
        "source": "/account-deletion.html",
        "destination": "/accountdeletion",
        "type": 301
      },
      {
        "source": "/accountdeletion.html",
        "destination": "/accountdeletion",
        "type": 301
      },
      {
        "source": "/admin/index.html",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/admin/dashboard.html",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/admin/login.html",
        "destination": "/admin/login",
        "type": 301
      },
      {
        "source": "/admin/users.html",
        "destination": "/admin/users",
        "type": 301
      },
      {
        "source": "/admin/jobs.html",
        "destination": "/admin/jobs",
        "type": 301
      },
      {
        "source": "/admin/applications.html",
        "destination": "/admin/applications",
        "type": 301
      },
      {
        "source": "/admin/referrals.html",
        "destination": "/admin/referrals",
        "type": 301
      },
      {
        "source": "/admin/announcements.html",
        "destination": "/admin/announcements",
        "type": 301
      },
      {
        "source": "/admin/post-job.html",
        "destination": "/admin/post-job",
        "type": 301
      },
      {
        "source": "/admin/check-and-create-code.html",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/admin/create-test-referral.html",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/admin/test-referral.html",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/admin/dashboard",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/admin/workers",
        "destination": "/admin/worker-profiles",
        "type": 301
      },
      {
        "source": "/admin/worker-profiles.html",
        "destination": "/admin/worker-profiles",
        "type": 301
      },
      {
        "source": "/admin/employers",
        "destination": "/admin/employer-profiles",
        "type": 301
      },
      {
        "source": "/admin/employer-profiles.html",
        "destination": "/admin/employer-profiles",
        "type": 301
      },
      {
        "source": "/admin/profiles",
        "destination": "/admin/users",
        "type": 301
      },
      {
        "source": "/admin/job-posts",
        "destination": "/admin/jobs",
        "type": 301
      },
      {
        "source": "/admin/referral-withdrawals",
        "destination": "/admin/referral-stats",
        "type": 301
      },
      {
