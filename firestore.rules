rules_version = '2';
// ──────────────────────────────────────────────────────────────────────────
// DutyPe Firestore rules — mirror of FirestoreSchema.kt / functions/src/schema.ts.
//
//   • Anything that moves money, changes a count, or involves two people (jobs, applications,
//     instant needs, ratings, wallets, subscriptions) is written ONLY by Cloud Functions
//     (Admin SDK bypasses these rules).
//   • The app writes just its own profile fields, push token, saved jobs, saved places,
//     notification read-state, payment proofs, feedback and launch-demand leads —
//     each field-whitelisted.
//   • Reads are scoped to the caller; collections with personal data can't be listed.
//   • Admins (web panel) can read and write everything.
// ──────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isSelf(uid) { return signedIn() && me() == uid; }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'ADMIN' ||
        (request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') is string &&
          (request.auth.token.email.lower().matches('.*@dutype\\.com$') ||
           request.auth.token.email.lower() in ['vamsib298@gmail.com', 'dutpyein@gmail.com']))
      );
    }

    /** Only these keys changed. */
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function optString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function optNumberIn(data, key, lo, hi) {
      return !(key in data) || (data[key] is number && data[key] >= lo && data[key] <= hi);
    }

    function validPlace(d) {
      return optNumberIn(d, 'lat', -90, 90) && optNumberIn(d, 'lng', -180, 180) &&
        optString(d, 'geohash', 12) && optString(d, 'address', 300) && optString(d, 'area', 60);
    }

    // Admins: full access everywhere (read-only tooling + moderation).
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ───────────────────────── identity ─────────────────────────

    // Pre-OTP "is this number registered, and as what?" — single-document get only.
    // Only the signed-in owner of the number. Before sign-in the app asks lookupPhoneRole (App
    // Check protected), so nobody can test phone numbers against the database.
    match /phoneRoles/{phone} {
      allow get: if signedIn() && request.auth.token.phone_number == phone;
    }

    match /user_tokens/{uid} {
      allow get, delete: if isSelf(uid);
      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['fcmToken', 'language', 'updatedAt']) &&
        optString(request.resource.data, 'fcmToken', 4096) &&
        optString(request.resource.data, 'language', 5);
    }

    match /worker_profiles/{uid} {
      allow get: if isSelf(uid);
      allow update: if isSelf(uid) &&
        onlyChanges(['name', 'photoUrl', 'gender', 'dateOfBirth', 'education', 'experienceYears', 'skills',
                     'bio', 'address', 'area', 'lat', 'lng', 'geohash', 'available', 'updatedAt']) &&
        optString(request.resource.data, 'name', 80) &&
        optString(request.resource.data, 'bio', 1000) &&
        optNumberIn(request.resource.data, 'experienceYears', 0, 60) &&
        (!('skills' in request.resource.data) ||
          (request.resource.data.skills is list && request.resource.data.skills.size() <= 10)) &&
        (!('available' in request.resource.data) || request.resource.data.available is bool) &&
        validPlace(request.resource.data);
    }

    // Public worker card (no phone); written by the profile trigger.
    // One card at a time by id (applicants, ratings). No listing, so nobody can page through
    // every worker; employer matching runs on the server.
    match /worker_cards/{uid} {
      allow get: if signedIn();
    }

    // The public face of an employer (name, photo, area, rating), synced by the server.
    match /employer_cards/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 30;
    }

    // Private: phone, GSTIN, address and billing. Others see employer_cards.
    match /employer_profiles/{uid} {
      allow get: if isSelf(uid);
      allow update: if isSelf(uid) &&
        onlyChanges(['employerType', 'ownerName', 'businessName', 'businessType', 'gstin', 'photoUrl',
                     'address', 'area', 'lat', 'lng', 'geohash', 'updatedAt']) &&
        (!('employerType' in request.resource.data) ||
          request.resource.data.employerType in ['INDIVIDUAL', 'COMPANY']) &&
        optString(request.resource.data, 'ownerName', 80) &&
        optString(request.resource.data, 'businessName', 100) &&
        optString(request.resource.data, 'gstin', 15) &&
        validPlace(request.resource.data);

      // Workers whose phone this employer revealed (server-written).
      match /unlocks/{workerId} {
        allow read: if isSelf(uid);
      }

      match /work_locations/{locationId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid) &&
          request.resource.data.keys().hasOnly(['label', 'address', 'lat', 'lng']) &&
          request.resource.data.label is string && request.resource.data.label.size() <= 80 &&
          request.resource.data.address is string && request.resource.data.address.size() <= 500 &&
          request.resource.data.lat is number && request.resource.data.lng is number;
      }
    }

    // ───────────────────────── jobs ─────────────────────────

    // Job cards, details and the cell index are public (guests browse; share links work).
    match /jobmetadata/{jobId} {
      allow get, list: if true;
    }

    match /job_details/{jobId} {
      allow get: if true;
    }

    // The employer's number for a job: only the employer reads it; workers get it from
    // applyToJob(viaCall), which records the call.
    match /job_contacts/{jobId} {
      allow get: if signedIn() && resource.data.employerId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow get: if signedIn() &&
        (resource == null || resource.data.workerId == me() || resource.data.employerId == me());
      allow list: if signedIn() && (resource.data.workerId == me() || resource.data.employerId == me());
    }

    // saved_jobs/{uid}_{jobId}
    match /saved_jobs/{saveId} {
      allow get, delete: if signedIn() && saveId.matches(me() + '_.+');
      allow list: if signedIn() && resource.data.userId == me();
      allow create: if signedIn() &&
        saveId == me() + '_' + request.resource.data.jobId &&
        request.resource.data.keys().hasOnly(['userId', 'jobId', 'createdAt']) &&
        request.resource.data.userId == me() &&
        request.resource.data.createdAt is timestamp;
    }

    // ───────────────────────── instant help ─────────────────────────

    match /instant_requests/{requestId} {
      allow get, list: if signedIn();

      match /responses/{workerId} {
        allow get: if isSelf(workerId) ||
          (signedIn() && get(/databases/$(database)/documents/instant_requests/$(requestId)).data.employerId == me());
        allow list: if signedIn() &&
          get(/databases/$(database)/documents/instant_requests/$(requestId)).data.employerId == me();
      }
    }

    // A worker's own responses across all needs (urgent work history).
    match /{path=**}/responses/{workerId} {
      allow list: if signedIn() && resource.data.workerId == me();
    }

    // ───────────────────────── trust ─────────────────────────

    match /ratings/{ratingId} {
      allow get, list: if signedIn();
    }

    // ───────────────────────── notifications ─────────────────────────

    match /notifications/{notificationId} {
      allow get, list, delete: if signedIn() && resource.data.recipientId == me();
      allow update: if signedIn() && resource.data.recipientId == me() &&
        onlyChanges(['read']) && request.resource.data.read is bool;
    }

    // ───────────────────────── referrals & wallet ─────────────────────────

    match /referral_codes/{code} {
      allow get: if true;   // checked on the sign-up screen, before an account exists
    }

    // referrals/{refereeUid}
    match /referrals/{refereeUid} {
      allow get: if isSelf(refereeUid) || (signedIn() && resource != null && resource.data.referrerUid == me());
      allow list: if signedIn() && resource.data.referrerUid == me();
    }

    match /referral_stats/{uid} {
      allow get: if isSelf(uid);
    }

    match /wallet_ledger/{eventId} {
      allow get, list: if signedIn() && resource.data.uid == me();
    }

    match /withdrawal_requests/{withdrawalId} {
      allow get, list: if signedIn() && resource.data.uid == me();
    }

    // ───────────────────────── subscriptions ─────────────────────────

    match /subscription_payment_requests/{requestId} {
      allow get, list: if signedIn() && resource.data.employerId == me();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['employerId', 'planId', 'amountPaise', 'upiIdUsed', 'utrNumber',
                                              'screenshotUrl', 'status', 'createdAt']) &&
        request.resource.data.employerId == me() &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.planId is string && request.resource.data.planId.size() <= 40 &&
        request.resource.data.amountPaise is int && request.resource.data.amountPaise >= 0 &&
        request.resource.data.utrNumber is string && request.resource.data.utrNumber.matches('^[0-9]{12}$') &&
        optString(request.resource.data, 'upiIdUsed', 100) &&
        optString(request.resource.data, 'screenshotUrl', 1000) &&
        request.resource.data.createdAt is timestamp;
    }

    match /active_qr_codes/{qrId} {
      allow get, list: if signedIn();
    }

    // ───────────────────────── app content ─────────────────────────

    match /app_config/{docId} {
      allow get: if true;
    }

    match /announcements/{announcementId} {
      allow get, list: if true;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'role', 'rating', 'category', 'text', 'appVersion', 'createdAt']) &&
        request.resource.data.uid == me() &&
        request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        optString(request.resource.data, 'text', 1000) &&
        optString(request.resource.data, 'category', 40) &&
        request.resource.data.createdAt is timestamp;
    }

    match /location_demand/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['uid', 'area', 'lat', 'lng', 'category', 'createdAt']) &&
        (request.resource.data.uid == '' || (signedIn() && request.resource.data.uid == me())) &&
        request.resource.data.area is string && request.resource.data.area.size() <= 80 &&
        optString(request.resource.data, 'category', 40);
    }

    // Everything else (idempotency, withdrawal_daily, broadcast_notifications, admins, …) is
    // server/admin only: no client rule matches, so it is denied.
  }
}
