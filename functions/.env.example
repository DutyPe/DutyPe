# Copy to functions/.env (never commit the real file). Used by Cloud Functions at deploy time.

# Azure endpoints and names are committed in .env.dutype-860ac. The Azure keys are Firebase
# secrets, not env vars — do NOT put AZURE_OPENAI_KEY / AZURE_COSMOS_KEY in any .env file:
#   firebase functions:secrets:set AZURE_OPENAI_KEY
#   firebase functions:secrets:set AZURE_COSMOS_KEY

# Gemini — optional fallback when Azure OpenAI is not set
GEMINI_API_KEY=
