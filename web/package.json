{
  "name": "dutype-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); ['.next', '.next-dev'].forEach((path)=>fs.rmSync(path,{ recursive: true, force: true }))\"",
    "dev": "next dev",
    "dev:fresh": "npm run clean && next dev",
    "build": "next build",
    "build:fresh": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test",
    "type-check": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@chenglou/pretext": "file:vendor/chenglou-pretext-0.0.9.tgz",
    "firebase": "^11.6.1",
    "firebase-admin": "^12.7.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "file:vendor/server-only-0.0.1.tgz"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "axe-core": "4.12.1",
    "esbuild": "0.27.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "playwright": "1.60.0",
    "typescript": "^5.5.4"
  }
}
