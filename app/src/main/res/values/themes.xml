<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.DutyPe" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 
            You can customize your theme here.
            For example, defining primary, secondary colors etc.
            Example:
            <item name="colorPrimary">@color/my_light_primary</item> 
        -->
    </style>

    <!--
        MODERN SPLASH SCREEN (Android 12+ API)

        Per-user request (April 2026): only the in-app AnimatedSplashScreen
        ("DutyPe" letter reveal) should be visible. The system splash is
        unavoidable on Android 12+ (OS-enforced cold-start behaviour), but
        we strip the launcher icon and use the same pure-black background
        as the Compose splash so the system splash becomes an invisible
        black hand-off frame instead of a second, distinct splash.
    -->
    <style name="Theme.DutyPe.Splash" parent="Theme.SplashScreen">
        <!-- Pure black background — matches AnimatedSplashScreen so the
             system splash visually merges into the Compose splash. -->
        <item name="windowSplashScreenBackground">#000000</item>

        <!-- Fully-transparent icon so the OS doesn't fall back to the
             launcher icon. The user wants ONLY the Compose
             AnimatedSplashScreen ("DutyPe" letter reveal) to be visible;
             the system splash on Android 12+ is unavoidable but with a
             transparent icon + matching black background it appears as a
             plain black frame that blends into the Compose splash. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/splash_icon_transparent</item>

        <!-- Zero-duration icon animation. -->
        <item name="windowSplashScreenAnimationDuration">0</item>

        <!-- Black icon background (kept for the OS exit-animation crop). -->
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>

        <!-- Post-splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.DutyPe</item>

        <!-- Black status bar and navigation bar -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
