# Non-secret Azure settings for the dutype-860ac project (loaded by firebase deploy).
# The keys are NOT here: they are Firebase secrets —
#   firebase functions:secrets:set AZURE_OPENAI_KEY
#   firebase functions:secrets:set AZURE_COSMOS_KEY
AZURE_OPENAI_ENDPOINT=https://dutype-openai.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=dutype-chat
AZURE_COSMOS_ENDPOINT=https://dutype-cosmos.documents.azure.com:443/
AZURE_COSMOS_DATABASE=dutype

# WhatsApp login codes (Meta WhatsApp Cloud API). Fill these after Meta setup; the token is the
# Firebase secret WHATSAPP_TOKEN (set it to "unset" until then — the app then uses SMS).
WHATSAPP_PHONE_NUMBER_ID=1285842094620024
WHATSAPP_TEMPLATE=dutype_login_otp
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_DAILY_CAP=3000

# Truecaller one-tap login: client ID from the Truecaller developer portal (not a secret).
TRUECALLER_CLIENT_ID=-kqtniuuyzghbxcn_q52rjxhipc_8tuttzryunaupwu
