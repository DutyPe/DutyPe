rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile images - users can only write to their own folder, anyone can read
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if true;  // Anyone can view profile images
      allow write: if request.auth != null && request.auth.uid == userId;  // Only the owner can upload
    }
    
    // Job images - employers can upload job images to their own folder
    match /job_images/{userId}/{allPaths=**} {
      allow read: if true;  // Anyone can view job images
      allow write: if request.auth != null && request.auth.uid == userId;  // Only the owner can upload
    }
    
    // Cover letters - workers can upload to their own folder, employers can read
    match /cover_letters/{userId}/{allPaths=**} {
      allow read: if request.auth != null;  // Authenticated users can read (employers viewing applications)
      allow write: if request.auth != null && request.auth.uid == userId;  // Only the owner can upload
    }
    
    // Default rule - deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
