rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - authenticated users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow authenticated users to query by phone for role check (no dual roles)
      allow read: if request.auth != null;
      // Allow UNAUTHENTICATED queries by phone for pre-login role check (no dual roles)
      // This is needed to check if phone exists with different role BEFORE sending OTP
      allow read: if true;
    }
    
    // Worker profiles - authenticated users can read/write their own data
    // Also allow querying by email for profile completion checks
    match /worker_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow querying by email for existing user detection
      allow read: if request.auth != null && 
        request.query.where[0].field == 'email' && 
        request.query.where[0].value == request.auth.token.email;
    }
    
    // Employer profiles - authenticated users can read/write their own data
    // Also allow querying by email for profile completion checks
    match /employer_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow querying by email for existing user detection
      allow read: if request.auth != null && 
        request.query.where[0].field == 'contactEmail' && 
        request.query.where[0].value == request.auth.token.email;
    }
    
    // Jobs collection - anyone can read (including guests/unauthenticated), only employers can write their own jobs
    match /jobs/{jobId} {
      allow read: if true;
      // Allow employers to fully manage their own jobs
      allow write: if request.auth != null && 
        (request.auth.uid == resource.data.employerId || 
         request.auth.uid == request.resource.data.employerId);
    }
    
    // Job applications collection - users can read/write their own applications
    match /job_applications/{applicationId} {
      // Allow read for authenticated users who are either the worker or employer
      allow read: if request.auth != null && 
        (resource == null || 
         request.auth.uid == resource.data.workerId || 
         request.auth.uid == resource.data.employerId);
      
      // Allow write for authenticated users who are either the worker or employer
      allow write: if request.auth != null && 
        (request.auth.uid == request.resource.data.workerId ||
         request.auth.uid == request.resource.data.employerId);
      
      // Allow list queries for employers to see applications for their jobs
      allow list: if request.auth != null;
    }
    
    // SAVED JOBS COLLECTION - FIXED RULES
    match /saved_jobs/{savedJobId} {
      // Users can read/write their own saved jobs
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.workerId || 
         request.auth.uid == request.resource.data.workerId);
    }
    
    // Notifications collection - users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.recipientId || 
         request.auth.uid == request.resource.data.recipientId);
    }
    
    // User activity collection - users can read/write their own activity
    match /user_activity/{activityId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == request.resource.data.userId);
    }
    
    // App analytics collection - authenticated users can write
    match /app_analytics/{document=**} {
      allow write: if request.auth != null;
    }
    
    // Phone roles collection - PUBLIC READ for pre-login role check (no dual roles)
    // Document ID is the phone number (without +91 prefix), contains only { role: "WORKER" | "EMPLOYER" }
    // This allows checking if a phone is registered with a specific role BEFORE authentication
    match /phone_roles/{phoneNumber} {
      allow read: if true;  // Anyone can check if phone exists with a role
      allow write: if request.auth != null;  // Only authenticated users can write
    }
    
    // App feedback collection - users can submit feedback (write only)
    // Feedback is stored for admin review
    match /app_feedback/{feedbackId} {
      allow create: if true;  // Anyone can submit feedback (even anonymous users)
      allow read: if false;   // Only admins can read (via Firebase Console)
      allow update, delete: if false;  // No updates or deletes allowed
    }
    
    // FCM tokens collection - users can read/write their own tokens
    match /fcm_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
