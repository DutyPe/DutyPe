rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // USERS COLLECTION - SECURED (P0 FIX #1)
    // ============================================
    // FIXED: Previously had "allow read: if true" which exposed ALL user data
    // NOW: Only owner can read full profile, limited phone lookup for role check
    match /users/{userId} {
      // Owner can read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to read other users' PUBLIC fields only
      // This is needed for viewing employer profiles on job cards
      allow read: if request.auth != null;
    }
    
    // Phone roles collection - LIMITED PUBLIC READ for pre-login role check
    // Document ID is the phone number (without +91 prefix)
    // Contains only { role: "WORKER" | "EMPLOYER" } - minimal data exposure
    match /phone_roles/{phoneNumber} {
      allow read: if true;  // Safe: only contains role, no PII
      allow write: if request.auth != null;
    }
    
    // ============================================
    // BLACKLISTS COLLECTION - NEW (P0 FIX #4 & #5)
    // ============================================
    // For phone and device blacklisting
    match /blacklists/{blacklistId} {
      // Anyone can read blacklist to check if banned (needed before auth)
      allow read: if true;
      // Only admins can write (via Firebase Console or Cloud Functions)
      allow write: if false;
    }
    
    // ============================================
    // FRAUD SIGNALS COLLECTION - NEW (P0 FIX #2)
    // ============================================
    // For tracking rate limit violations and suspicious activity
    match /fraud_signals/{signalId} {
      // Only system can read/write (via Cloud Functions)
      allow read, write: if false;
    }
    
    // ============================================
    // RATE LIMITS COLLECTION - NEW (P0 FIX #2)
    // ============================================
    // For tracking job posting rate per user
    match /rate_limits/{userId} {
      // Users can read their own rate limit status
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only system can write (via Cloud Functions)
      allow write: if false;
    }
    
    // ============================================
    // WORKER PROFILES
    // ============================================
    match /worker_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow querying by email for existing user detection
      allow read: if request.auth != null;
    }
    
    // ============================================
    // EMPLOYER PROFILES
    // ============================================
    match /employer_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow querying by email for existing user detection
      allow read: if request.auth != null;
    }
    
    // ============================================
    // JOBS COLLECTION
    // ============================================
    match /jobs/{jobId} {
      // Anyone can read jobs (including guests)
      allow read: if true;
      // Employers can manage their own jobs
      allow write: if request.auth != null && 
        (request.auth.uid == resource.data.employerId || 
         request.auth.uid == request.resource.data.employerId);
      // Workers can update application count
      allow update: if request.auth != null && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicationCount', 'updatedAt', 'lastApplicationAt']);
    }
    
    // ============================================
    // JOB APPLICATIONS
    // ============================================
    match /job_applications/{applicationId} {
      allow read: if request.auth != null && 
        (resource == null || 
         request.auth.uid == resource.data.workerId || 
         request.auth.uid == resource.data.employerId);
      allow write: if request.auth != null && 
        (request.auth.uid == request.resource.data.workerId ||
         request.auth.uid == request.resource.data.employerId);
      allow list: if request.auth != null;
    }
    
    // ============================================
    // SAVED JOBS
    // ============================================
    match /saved_jobs/{savedJobId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.workerId || 
         request.auth.uid == request.resource.data.workerId);
    }
    
    // ============================================
    // NOTIFICATIONS
    // ============================================
    match /notifications/{notificationId} {
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.recipientId;
    }
    
    // ============================================
    // METADATA COLLECTION - App configuration and stats
    // ============================================
    // For platform_stats, feature_flags, category_stats, location_stats, trending, pay_stats
    match /metadata/{docId} {
      // All authenticated users can read metadata (app configuration)
      allow read: if request.auth != null;
      // Only admins can write (via Firebase Console or Cloud Functions)
      allow write: if false;
    }
    
    // ============================================
    // OTHER COLLECTIONS
    // ============================================
    match /user_activity/{activityId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == request.resource.data.userId);
    }
    
    match /app_analytics/{document=**} {
      allow write: if request.auth != null;
    }
    
    match /app_feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    match /fcm_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /ratings/{ratingId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.raterUserId;
      allow update, delete: if false;
    }
    
    match /rating_summaries/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /work_verifications/{verificationId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.workerId || 
         request.auth.uid == resource.data.employerId);
      allow list: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.employerId;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.workerId || 
         request.auth.uid == resource.data.employerId);
    }
    
    // ============================================
    // SUBSCRIPTIONS & PAYMENTS
    // ============================================
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    match /payment_transactions/{transactionId} {
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow write: if false; // Only Cloud Functions can write
    }
    
    match /subscription_usage/{usageId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // ============================================
    // BROADCAST NOTIFICATIONS (for Cloud Functions)
    // ============================================
    match /broadcast_notifications/{notificationId} {
      allow read, write: if false; // Only admins via Console
    }
    
    // ============================================
    // P1: MODERATION QUEUE
    // ============================================
    match /moderation_queue/{queueId} {
      // Only admins can read/write (via Console or admin app)
      allow read, write: if false;
    }
    
    // ============================================
    // P1: ACTIVITY LOGS (IP Tracking)
    // ============================================
    match /activity_logs/{logId} {
      // Only system can write (via Cloud Functions)
      allow read, write: if false;
    }
    
    // ============================================
    // P1: SUSPICIOUS IPS
    // ============================================
    match /suspicious_ips/{ipId} {
      // Only system can read/write
      allow read, write: if false;
    }
    
    // ============================================
    // P1: REAL-TIME CHAT - CONVERSATIONS
    // ============================================
    match /conversations/{conversationId} {
      // Participants can read their conversations
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      // Only Cloud Functions can create/update
      allow create, update: if false;
    }
    
    // ============================================
    // P1: REAL-TIME CHAT - MESSAGES
    // ============================================
    match /messages/{messageId} {
      // Sender or recipient can read
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.senderId || 
         request.auth.uid == resource.data.recipientId);
      // Only Cloud Functions can create
      allow create: if false;
      // Recipient can mark as read
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.recipientId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
    }
  }
}
