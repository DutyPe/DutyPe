{
  "firestore": {
    "indexes": "firestore.indexes.json",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/jobs/:jobId",
        "destination": "/app-redirect.html"
      },
      {
        "source": "/refer/:code",
        "destination": "/app-redirect.html"
      },
      {
        "source": "/worker/:workerId",
        "destination": "/app-redirect.html"
      },
      {
        "source": "/application/:applicationId",
        "destination": "/app-redirect.html"
      },
      {
        "source": "/employer/:employerId",
        "destination": "/app-redirect.html"
      },
      {
        "source": "/chat/:chatId",
        "destination": "/app-redirect.html"
      },
      {
        "source": "/profile",
        "destination": "/app-redirect.html"
      },
      {
        "source": "/notifications",
        "destination": "/app-redirect.html"
      }
    ],
    "headers": [
      {
        "source": "/app-ads.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  }
}


