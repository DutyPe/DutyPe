<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE variant. Forbids all cleartext HTTP traffic.
  Production DutyPe endpoints MUST be HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
