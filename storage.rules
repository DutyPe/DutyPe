rules_version = '2';
// ──────────────────────────────────────────────────────────────────────────
// DutyPe Storage Security Rules — owner-scoped with size + content-type caps.
// ──────────────────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.get('admin', false) == true) ||
        (request.auth.token.get('role', '') == 'ADMIN') ||
        (request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') is string &&
          (
            request.auth.token.email.lower().matches('.*@dutype\\.com$') ||
            request.auth.token.email.lower() in [
              'admin@dutype.com',
              'vamsi@dutype.com',
              'vamsib298@gmail.com',
              'dutpyein@gmail.com'
            ]
          )
        )
      );
    }


    // Profile images — public read (displayed in job cards), owner-only write.
    // 5 MB cap, image content types only.
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Job images — public read, employer-only write.
    match /job_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Payment QR codes shown on the plans screen — public read, admin-only write.
    match /active_qrs/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Dynamic configuration assets (banners, lottie) — public read, admin-only write.
    match /dynamic_assets/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Payment screenshots — owner-only write, admin/owner read
    match /payment_screenshots/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
