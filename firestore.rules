rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validLatLng(loc) {
      return loc is map &&
        loc.keys().hasOnly(['lat', 'lng']) &&
        loc.lat is number && loc.lat >= -90 && loc.lat <= 90 &&
        loc.lng is number && loc.lng >= -180 && loc.lng <= 180;
    }

    function validRoles(roles, activeRole) {
      return roles is list &&
        roles.size() > 0 &&
        roles.size() <= 2 &&
        roles.toSet().hasOnly(['WORKER', 'EMPLOYER']) &&
        roles.toSet().hasAny([activeRole]);
    }

    // users
    match /users/{userId} {
      allow get, list: if isSelf(userId);

      allow create: if isSelf(userId) &&
        request.resource.data.keys().hasOnly([
          'userId', 'phone', 'fullName', 'profileImageUrl', 'roles', 'activeRole',
          'location', 'geohash', 'isVerified', 'isActive', 'fcmToken',
          'createdAt', 'lastActiveAt', 'referralCode', 'referredByCode', 'referredByUserId'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'phone', 'fullName', 'roles', 'activeRole',
          'isVerified', 'isActive', 'createdAt', 'lastActiveAt'
        ]) &&
        request.resource.data.userId == userId &&
        request.resource.data.phone is string &&
        request.resource.data.fullName is string &&
        validRoles(request.resource.data.roles, request.resource.data.activeRole) &&
        request.resource.data.activeRole is string &&
        (!('location' in request.resource.data) || validLatLng(request.resource.data.location)) &&
        (!('geohash' in request.resource.data) || request.resource.data.geohash is string) &&
        request.resource.data.isVerified is bool &&
        request.resource.data.isActive is bool &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.lastActiveAt is timestamp &&
        (!('profileImageUrl' in request.resource.data) || request.resource.data.profileImageUrl is string) &&
        (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken is string) &&
        (!('referralCode' in request.resource.data) || request.resource.data.referralCode is string) &&
        (!('referredByCode' in request.resource.data) || request.resource.data.referredByCode is string) &&
        (!('referredByUserId' in request.resource.data) || request.resource.data.referredByUserId is string);

      allow update: if isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'activeRole', 'fcmToken']) &&
        (!('lastActiveAt' in request.resource.data) || request.resource.data.lastActiveAt is timestamp) &&
        (!('activeRole' in request.resource.data) ||
          (request.resource.data.activeRole is string &&
           request.resource.data.roles.toSet().hasAny([request.resource.data.activeRole]))) &&
        (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken is string);

      allow update: if isSelf(userId) &&
        request.resource.data.keys().hasOnly([
          'userId', 'phone', 'fullName', 'profileImageUrl', 'roles', 'activeRole',
          'location', 'geohash', 'isVerified', 'isActive', 'fcmToken',
          'createdAt', 'lastActiveAt', 'referralCode', 'referredByCode', 'referredByUserId'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'phone', 'fullName', 'roles', 'activeRole',
          'isVerified', 'isActive', 'createdAt', 'lastActiveAt'
        ]) &&
        request.resource.data.userId == userId &&
        request.resource.data.phone == resource.data.phone &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.fullName is string &&
        validRoles(request.resource.data.roles, request.resource.data.activeRole) &&
        (!('location' in request.resource.data) || validLatLng(request.resource.data.location)) &&
        (!('geohash' in request.resource.data) || request.resource.data.geohash is string) &&
        request.resource.data.isVerified is bool &&
        request.resource.data.isActive is bool &&
        request.resource.data.lastActiveAt is timestamp &&
        (!('profileImageUrl' in request.resource.data) || request.resource.data.profileImageUrl is string) &&
        (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken is string) &&
        (!('referralCode' in request.resource.data) || request.resource.data.referralCode is string) &&
        (!('referredByCode' in request.resource.data) || request.resource.data.referredByCode is string) &&
        (!('referredByUserId' in request.resource.data) || request.resource.data.referredByUserId is string);

      allow delete: if false;
    }

    // worker_profiles
    match /worker_profiles/{userId} {
      allow get: if isSelf(userId);
      allow list: if isSignedIn();
      allow create, update: if isSelf(userId) &&
        request.resource.data.keys().hasOnly([
          'userId', 'jobTypes', 'skills', 'isAvailable', 'rating', 'totalRatings', 'totalJobs', 'lastActiveAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'isAvailable', 'rating', 'totalRatings', 'totalJobs', 'lastActiveAt'
        ]) &&
        request.resource.data.userId == userId &&
        (!('jobTypes' in request.resource.data) || request.resource.data.jobTypes is list) &&
        (!('skills' in request.resource.data) || request.resource.data.skills is list) &&
        request.resource.data.isAvailable is bool &&
        request.resource.data.rating is number &&
        request.resource.data.totalRatings is int &&
        request.resource.data.totalJobs is int &&
        request.resource.data.lastActiveAt is timestamp;
      allow delete: if isSelf(userId);
    }

    // employer_profiles
    match /employer_profiles/{userId} {
      allow get: if isSelf(userId);
      allow list: if isSignedIn();
      allow create, update: if isSelf(userId) &&
        request.resource.data.keys().hasOnly([
          'userId', 'companyName', 'rating', 'totalRatings', 'totalHires', 'isVerified', 'lastActiveAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'companyName', 'rating', 'totalRatings', 'totalHires'
        ]) &&
        request.resource.data.userId == userId &&
        request.resource.data.companyName is string &&
        request.resource.data.rating is number &&
        request.resource.data.totalRatings is int &&
        request.resource.data.totalHires is int &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified is bool) &&
        (!('lastActiveAt' in request.resource.data) || request.resource.data.lastActiveAt is timestamp);
      allow delete: if isSelf(userId);
    }

    // jobs (public read)
    match /jobs/{jobId} {
      allow get, list: if true;

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'employerId', 'companyName', 'isVerified', 'title', 'jobType',
          'salary', 'salaryType', 'gender', 'experienceRequired', 'shiftTiming',
          'applicationCount', 'location', 'geohash', 'companyCity', 'addressText',
          'urgency', 'status', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'employerId', 'title', 'salary', 'salaryType',
          'location', 'geohash', 'urgency', 'status', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.employerId == request.auth.uid &&
        (!('companyName' in request.resource.data) || request.resource.data.companyName is string) &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified is bool) &&
        request.resource.data.title is string &&
        (!('jobType' in request.resource.data) || request.resource.data.jobType is string) &&
        request.resource.data.salary is number &&
        request.resource.data.salaryType is string &&
        (!('gender' in request.resource.data) || request.resource.data.gender is string) &&
        (!('experienceRequired' in request.resource.data) || request.resource.data.experienceRequired is string) &&
        (!('shiftTiming' in request.resource.data) || request.resource.data.shiftTiming is string) &&
        (!('applicationCount' in request.resource.data) || request.resource.data.applicationCount is int) &&
        validLatLng(request.resource.data.location) &&
        request.resource.data.geohash is string &&
        (!('companyCity' in request.resource.data) || request.resource.data.companyCity is string) &&
        request.resource.data.urgency in ['LOW', 'MEDIUM', 'HIGH'] &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.expiresAt is timestamp;

      allow update: if isSignedIn() &&
        resource.data.employerId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'employerId', 'companyName', 'isVerified', 'title', 'jobType',
          'salary', 'salaryType', 'gender', 'experienceRequired', 'shiftTiming',
          'applicationCount', 'location', 'geohash', 'companyCity', 'addressText',
          'urgency', 'status', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.employerId == resource.data.employerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (!('companyName' in request.resource.data) || request.resource.data.companyName is string) &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified is bool) &&
        request.resource.data.title is string &&
        (!('jobType' in request.resource.data) || request.resource.data.jobType is string) &&
        request.resource.data.salary is number &&
        request.resource.data.salaryType is string &&
        (!('gender' in request.resource.data) || request.resource.data.gender is string) &&
        (!('experienceRequired' in request.resource.data) || request.resource.data.experienceRequired is string) &&
        (!('shiftTiming' in request.resource.data) || request.resource.data.shiftTiming is string) &&
        (!('applicationCount' in request.resource.data) || request.resource.data.applicationCount is int) &&
        validLatLng(request.resource.data.location) &&
        request.resource.data.geohash is string &&
        (!('companyCity' in request.resource.data) || request.resource.data.companyCity is string) &&
        request.resource.data.urgency in ['LOW', 'MEDIUM', 'HIGH'] &&
        request.resource.data.status in ['open', 'closed', 'expired'] &&
        request.resource.data.expiresAt is timestamp;

      allow delete: if isSignedIn() && resource.data.employerId == request.auth.uid;
    }

    // job_details (full payload — requires auth to protect contact info)
    match /job_details/{jobId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
        existsAfter(/databases/$(database)/documents/jobs/$(jobId)) &&
        getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'employerId', 'companyName', 'isVerified', 'title', 'jobType',
          'salary', 'salaryType', 'description', 'contactNumber', 'addressText',
          'companyCity', 'location', 'geohash', 'gender', 'experienceRequired',
          'shiftTiming', 'vacancies', 'benefits', 'urgency', 'applicationCount',
          'status', 'createdAt', 'expiresAt',
          'whatsappNumber', 'workingHours', 'educationRequired'
        ]) &&
        request.resource.data.keys().hasAll([
          'description', 'contactNumber', 'addressText',
          'jobType', 'vacancies', 'benefits'
        ]) &&
        request.resource.data.description is string &&
        request.resource.data.contactNumber is string &&
        request.resource.data.addressText is string &&
        request.resource.data.jobType is string &&
        request.resource.data.vacancies is int &&
        request.resource.data.benefits is list &&
        (!('whatsappNumber' in request.resource.data) || request.resource.data.whatsappNumber is string) &&
        (!('workingHours' in request.resource.data) || request.resource.data.workingHours is string) &&
        (!('educationRequired' in request.resource.data) || request.resource.data.educationRequired is string);

      allow update: if isSignedIn() &&
        existsAfter(/databases/$(database)/documents/jobs/$(jobId)) &&
        getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'description', 'contactNumber', 'addressText',
          'jobType', 'vacancies', 'benefits',
          'whatsappNumber', 'workingHours', 'educationRequired'
        ]) &&
        (!('description' in request.resource.data) || request.resource.data.description is string) &&
        (!('contactNumber' in request.resource.data) || request.resource.data.contactNumber is string) &&
        (!('addressText' in request.resource.data) || request.resource.data.addressText is string) &&
        (!('jobType' in request.resource.data) || request.resource.data.jobType is string) &&
        (!('vacancies' in request.resource.data) || request.resource.data.vacancies is int) &&
        (!('benefits' in request.resource.data) || request.resource.data.benefits is list) &&
        (!('whatsappNumber' in request.resource.data) || request.resource.data.whatsappNumber is string) &&
        (!('workingHours' in request.resource.data) || request.resource.data.workingHours is string) &&
        (!('educationRequired' in request.resource.data) || request.resource.data.educationRequired is string);

      allow delete: if isSignedIn() &&
        exists(/databases/$(database)/documents/jobs/$(jobId)) &&
        get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid;
    }

    // applications
    match /applications/{applicationId} {
      allow get: if isSignedIn() &&
        (
          (resource != null && (resource.data.workerId == request.auth.uid || resource.data.employerId == request.auth.uid)) ||
          applicationId.matches('^.*_' + request.auth.uid + '$')
        );
      allow list: if isSignedIn() &&
        (resource == null || resource.data.workerId == request.auth.uid || resource.data.employerId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'jobId', 'workerId', 'employerId', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'jobId', 'workerId', 'employerId', 'status', 'createdAt'
        ]) &&
        request.resource.data.workerId == request.auth.uid &&
        request.resource.data.status == 'applied' &&
        request.resource.data.createdAt is timestamp &&
        applicationId == (request.resource.data.jobId + '_' + request.resource.data.workerId) &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.employerId == request.resource.data.employerId;

      allow update: if isSignedIn() &&
        (resource.data.workerId == request.auth.uid || resource.data.employerId == request.auth.uid) &&
        request.resource.data.keys().hasOnly([
          'jobId', 'workerId', 'employerId', 'status', 'createdAt'
        ]) &&
        request.resource.data.jobId == resource.data.jobId &&
        request.resource.data.workerId == resource.data.workerId &&
        request.resource.data.employerId == resource.data.employerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status in ['applied', 'shortlisted', 'rejected', 'hired'];

      allow delete: if false;
    }

    // work_locations/{userId}/locations/{locationId}
    // Used by WorkLocationManager to save and query employer saved addresses.
    match /work_locations/{userId} {
      allow get, list: if isSelf(userId);
      allow create, update, delete: if false;

      match /locations/{locationId} {
        allow get, list: if isSelf(userId);

        allow create: if isSelf(userId) &&
          request.resource.data.keys().hasOnly([
            'label', 'address', 'normalizedAddress',
            'latitude', 'longitude',
            'addedAt', 'updatedAt', 'usageCount'
          ]) &&
          request.resource.data.keys().hasAll([
            'label', 'address', 'normalizedAddress',
            'latitude', 'longitude',
            'addedAt', 'updatedAt', 'usageCount'
          ]) &&
          request.resource.data.label is string &&
          request.resource.data.address is string &&
          request.resource.data.normalizedAddress is string &&
          request.resource.data.latitude is number &&
          request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 &&
          request.resource.data.longitude is number &&
          request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180 &&
          request.resource.data.addedAt is int &&
          request.resource.data.updatedAt is int &&
          request.resource.data.usageCount is int &&
          request.resource.data.usageCount >= 0;

        allow update: if isSelf(userId) &&
          request.resource.data.keys().hasOnly([
            'label', 'address', 'normalizedAddress',
            'latitude', 'longitude',
            'addedAt', 'updatedAt', 'usageCount'
          ]) &&
          (!('label' in request.resource.data) || request.resource.data.label is string) &&
          (!('address' in request.resource.data) || request.resource.data.address is string) &&
          (!('normalizedAddress' in request.resource.data) || request.resource.data.normalizedAddress is string) &&
          (!('latitude' in request.resource.data) ||
            (request.resource.data.latitude is number &&
             request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90)) &&
          (!('longitude' in request.resource.data) ||
            (request.resource.data.longitude is number &&
             request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180)) &&
          (!('addedAt' in request.resource.data) || request.resource.data.addedAt is int) &&
          (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int) &&
          (!('usageCount' in request.resource.data) ||
            (request.resource.data.usageCount is int && request.resource.data.usageCount >= 0));

        allow delete: if isSelf(userId);
      }
    }

    // saved_jobs
    match /saved_jobs/{saveId} {
      // Support legacy docs that used workerId and avoid false PERMISSION_DENIED on missing docs.
      function savedJobOwnerFromData(data) {
        return ('userId' in data && data.userId == request.auth.uid) ||
          ('workerId' in data && data.workerId == request.auth.uid);
      }

      function saveIdOwnedByCaller() {
        return saveId.matches('^' + request.auth.uid + '_.*$');
      }

      allow get: if isSignedIn() &&
        (savedJobOwnerFromData(resource.data) || saveIdOwnedByCaller());
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['id', 'userId', 'workerId', 'jobId', 'createdAt']) &&
        request.resource.data.keys().hasAll(['jobId', 'createdAt']) &&
        (!('id' in request.resource.data) || request.resource.data.id == saveId) &&
        savedJobOwnerFromData(request.resource.data) &&
        request.resource.data.createdAt is timestamp &&
        saveIdOwnedByCaller();

      allow delete: if isSignedIn() &&
        (savedJobOwnerFromData(resource.data) || saveIdOwnedByCaller());
      allow update: if false;
    }

    // ratings
    match /ratings/{ratingId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'jobId', 'fromUserId', 'toUserId', 'rating', 'review', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'jobId', 'fromUserId', 'toUserId', 'rating', 'createdAt'
        ]) &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.jobId is string &&
        request.resource.data.toUserId is string &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.createdAt is timestamp &&
        (!('review' in request.resource.data) || request.resource.data.review is string);

      allow update, delete: if false;
    }

    // job_reports (one report per worker per job)
    match /job_reports/{reportId} {
      allow get: if isSignedIn() && resource.data.reporterId == request.auth.uid;
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'reportId', 'jobId', 'reporterId', 'reporterPhone',
          'reportType', 'description', 'timestamp', 'status'
        ]) &&
        request.resource.data.keys().hasAll([
          'jobId', 'reporterId', 'reportType', 'description', 'timestamp', 'status'
        ]) &&
        reportId == (request.auth.uid + '_' + request.resource.data.jobId) &&
        (!('reportId' in request.resource.data) || request.resource.data.reportId == reportId) &&
        request.resource.data.jobId is string &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reportType in ['SCAM', 'FAKE', 'INAPPROPRIATE', 'DUPLICATE', 'MISLEADING', 'HARASSMENT', 'SPAM', 'OTHER'] &&
        request.resource.data.description is string &&
        request.resource.data.timestamp is int &&
        request.resource.data.status == 'PENDING' &&
        (!('reporterPhone' in request.resource.data) || request.resource.data.reporterPhone is string) &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId));

      allow update, delete: if false;
    }

    // referrals
    match /referrals/{referralId} {
      allow get: if isSignedIn() &&
        (resource.data.referrerId == request.auth.uid || resource.data.referredUserId == request.auth.uid);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'referrerId', 'referredUserId', 'referralCode', 'status', 'reward', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'referrerId', 'referredUserId', 'status', 'createdAt'
        ]) &&
        request.resource.data.referredUserId == request.auth.uid &&
        referralId == (request.resource.data.referrerId + '_' + request.resource.data.referredUserId) &&
        request.resource.data.referrerId is string &&
        request.resource.data.referredUserId is string &&
        request.resource.data.status in ['pending', 'PENDING'] &&
        (!('referralCode' in request.resource.data) || request.resource.data.referralCode is string) &&
        (!('reward' in request.resource.data) || request.resource.data.reward is number) &&
        request.resource.data.createdAt is timestamp;

      allow update, delete: if false;
    }

    // referral_stats
    match /referral_stats/{userId} {
      allow get: if isSelf(userId);
      allow list: if isSignedIn();

      // Updated only by Cloud Functions (Admin SDK bypasses rules)
      allow create, update: if false;

      allow delete: if false;
    }

    // referral_codes
    match /referral_codes/{code} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'code', 'userId', 'userRole', 'userName', 'isActive', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'code', 'userId', 'userRole', 'userName', 'isActive', 'createdAt'
        ]) &&
        request.resource.data.code == code &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userRole in ['WORKER', 'EMPLOYER'] &&
        request.resource.data.userName is string &&
        request.resource.data.isActive is bool &&
        request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // users/{userId}/withdrawals
    match /users/{userId}/withdrawals/{withdrawalId} {
      allow get, list: if isSelf(userId);
      allow create, update, delete: if false;
    }

    // announcements (public read)
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'recipientId', 'title', 'message', 'type', 'data', 'isRead', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'recipientId', 'title', 'message', 'type', 'isRead', 'createdAt'
        ]) &&
        request.resource.data.recipientId is string &&
        request.resource.data.title is string &&
        request.resource.data.message is string &&
        request.resource.data.type is string &&
        request.resource.data.isRead is bool &&
        request.resource.data.createdAt is timestamp &&
        (!('data' in request.resource.data) || request.resource.data.data is map);

      allow update: if isSignedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.isRead is bool;

      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // conversations (chat)
    match /conversations/{conversationId} {
      allow get: if isSignedIn() &&
        resource.data.participants is list &&
        resource.data.participants.hasAny([request.auth.uid]);

      // Querying conversation list for current user
      allow list: if isSignedIn();

      // Created/updated by Cloud Functions using Admin SDK.
      allow create, update, delete: if false;
    }

    // messages (chat)
    match /messages/{messageId} {
      allow get: if isSignedIn() &&
        exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants.hasAny([request.auth.uid]);

      // Querying messages by conversationId for current user
      allow list: if isSignedIn();

      // Created/updated by Cloud Functions using Admin SDK.
      allow create, update, delete: if false;
    }

    // deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
