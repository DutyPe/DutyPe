      {
        "source": "/admin/create-test-referral",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/admin/test-referral",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/admin/whatsapp-groups",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/job",
        "destination": "/jobs",
        "type": 301
      },
      {
        "source": "/help",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/support",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/contact-us",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/worker/refer",
        "destination": "/refer",
        "type": 301
      },
      {
        "source": "/worker/referrals",
        "destination": "/refer",
        "type": 301
      },
      {
        "source": "/employer/refer",
        "destination": "/refer",
        "type": 301
      },
      {
        "source": "/employer/referrals",
        "destination": "/refer",
        "type": 301
      },
      {
        "regex": "^/(?:job|worker/jobs|app/worker/jobs)/(?P<id>[^/]+)/?$",
        "destination": "/jobs/:id",
        "type": 301
      },
      {
        "regex": "^/jobs/(?P<id>[^/]+)/renew/?$",
        "destination": "/jobs/:id",
        "type": 301
      },
      {
        "regex": "^/(?:app/)?worker/applications/(?P<id>[^/]+)/?$",
        "destination": "/application/:id",
        "type": 301
      },
      {
        "regex": "^/(?:app(?:/.*)?|post-job|applications?|chat/.*|(?:worker|employer)/(?:home|dashboard|jobs|applications|my-jobs|map|location|locations|profile|notifications|post-job|company|company-details|verification|urgent)(?:/.*)?)/?$",
        "destination": "/app-redirect",
        "type": 301
      },
      {
        "regex": "^/(?P<page>.+)\\.html$",
        "destination": "/:page",
        "type": 301
      }
    ]
  }
}
