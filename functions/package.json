{
  "name": "dutype-functions",
  "description": "Firebase Cloud Functions for DutyPe App - Push Notifications",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:security": "node --test --test-concurrency=1 ../scripts/android-firestore-rules.test.cjs ../scripts/android-backend-security.test.cjs ../scripts/android-push-contract.test.cjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "gcp-build": "npm install && npm run build"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/firestore": "6.8.0",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/express-serve-static-core@^5.0.0": "5.1.1"
  },
  "private": true
}
