# Required: Firebase Console > Project settings > General > Your apps > Web app.
# Use fields from the same web app configuration. There is no fallback key.
# API key, auth domain, project ID and app ID are required for account access.
# Storage bucket and messaging sender ID may be omitted if those services are unused.
# NEXT_PUBLIC values are bundled at build time: restart dev or rebuild production after changes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Search Console site verification meta token
GOOGLE_SITE_VERIFICATION=

# Server-side live listings, job details, and admin session verification.
# Required locally for /api/jobs and server-rendered city/job pages.
# Keep private credentials outside the repository; never use NEXT_PUBLIC_* for them.
# Choose one approach:
# 1. FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=relative/or/absolute/path/to/service-account.json
# 2. FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# 3. Individual fields below
FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
