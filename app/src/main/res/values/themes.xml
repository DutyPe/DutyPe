<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="Theme.DutyPe" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 
            You can customize your theme here.
            For example, defining primary, secondary colors etc.
            Example:
            <item name="colorPrimary">@color/my_light_primary</item> 
        -->
    </style>

    <!-- 
        MODERN SPLASH SCREEN (Android 12+ API)
        Following Google's official recommendations (2024-2026)
        
        Simple, clean branding with app icon
        Used by: WhatsApp, Instagram, LinkedIn, Uber
    -->
    <style name="Theme.DutyPe.Splash" parent="Theme.SplashScreen">
        <!-- Pure black background -->
        <item name="windowSplashScreenBackground">#000000</item>
        
        <!-- App launcher icon (adaptive icon) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        
        <!-- Fast animation (200ms) -->
        <item name="windowSplashScreenAnimationDuration">200</item>
        
        <!-- Black icon background -->
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>
        
        <!-- Post-splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.DutyPe</item>
        
        <!-- Black status bar and navigation bar -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
