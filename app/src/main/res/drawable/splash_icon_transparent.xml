<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully transparent 1x1 drawable used to suppress the launcher icon shown by the
  Android 12+ Splash Screen API. The system splash still draws the black
  background instantly on cold start; the Compose AnimatedSplashScreen then
  takes over with the animated DutyPe wordmark.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
