<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG variant only. Permits cleartext to local emulator/dev hosts.
  The release build uses app/src/release/res/xml/network_security_config.xml
  which forbids cleartext entirely.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.91.59.173</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
