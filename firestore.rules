rules_version = '2';
// ──────────────────────────────────────────────────────────────────────────
// DutyPe Firestore Security Rules — consolidated, production-grade, 5M-scale
// Ruthless schema. No backward-compat shims. No duplicated blocks.
// Principles:
//   • Every client write is field-whitelisted via hasOnly() and required via hasAll().
//   • Every mutable aggregate (rating, totalJobs, totalHires, referralStats, balance)
//     is Cloud-Function-only (Admin SDK bypasses rules).
//   • Ownership is always bound to request.auth.uid — never to a client-supplied field.
//   • Listings that could enumerate user data are closed; access via Callable CFs.
//   • Deterministic doc IDs prevent spoofing (applications, ratings, reports, saves, referrals).
// ──────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function isSelf(userId) { return isSignedIn() && request.auth.uid == userId; }

    // ── Admin authorization ──────────────────────────────────────────
    // Mirrors web/lib/firebase/admin-access.ts so the Next.js admin webapp
    // can read/write tooling collections (users, referrals, referral_codes,
    // app_config, etc.) directly from the browser using the signed-in admin's
    // ID token. Cloud Functions and the Admin SDK keep bypassing rules entirely.
    //
    // An admin is anyone who satisfies ANY of:
    //   • request.auth.token.admin == true
    //   • request.auth.token.role == 'ADMIN'
    //   • request.auth.token.activeRole == 'ADMIN'
    //   • request.auth.token.email ends with '@dutype.com'
    //   • request.auth.token.email is in the legacy allowlist
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.get('admin', false) == true) ||
        (request.auth.token.get('role', '') == 'ADMIN') ||
        (request.auth.token.get('activeRole', '') == 'ADMIN') ||
        (request.auth.token.get('email', '') is string &&
          (
            request.auth.token.email.lower().matches('.*@dutype\\.com$') ||
            request.auth.token.email.lower() in [
              'admin@dutype.com',
              'vamsi@dutype.com',
              'vamsib298@gmail.com',
              'dutpyein@gmail.com'
            ]
          )
        )
      );
    }

    function validLatLng(loc) {
      return loc is map &&
        loc.keys().hasOnly(['lat', 'lng']) &&
        loc.lat is number && loc.lat >= -90 && loc.lat <= 90 &&
        loc.lng is number && loc.lng >= -180 && loc.lng <= 180;
    }

    function validRole(role) {
      return role is string && (role == 'WORKER' || role == 'EMPLOYER');
    }

    // ── users ──────────────────────────────────────────────────────────
    // Source of truth for identity. Trust fields (isVerified, isActive) are CF-only.
    match /users/{userId} {
      // Admins (DutyPe internal staff) need full read/write for the Next.js
      // admin tooling (user list, referral utilities, etc).
      allow read, write: if isAdmin();

      allow get, list: if isSelf(userId);

      allow create: if isSelf(userId) &&
        request.resource.data.keys().hasOnly([
          'phone', 'fullName', 'profileImageUrl', 'role',
          'location', 'geohash', 'fcmToken', 'language',
          'createdAt', 'referralCode', 'referredByCode', 'referredByUserId'
        ]) &&
        request.resource.data.keys().hasAll([
          'phone', 'fullName', 'role', 'createdAt'
        ]) &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 20 &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 1 && request.resource.data.fullName.size() <= 120 &&
        validRole(request.resource.data.role) &&
        (!('location' in request.resource.data) || validLatLng(request.resource.data.location)) &&
        (!('geohash' in request.resource.data) || request.resource.data.geohash is string) &&
        request.resource.data.createdAt is timestamp &&
        (!('profileImageUrl' in request.resource.data) || request.resource.data.profileImageUrl is string) &&
        (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken is string) &&
        (!('referralCode' in request.resource.data) || request.resource.data.referralCode is string) &&
        (!('referredByCode' in request.resource.data) || request.resource.data.referredByCode is string) &&
        (!('referredByUserId' in request.resource.data) || request.resource.data.referredByUserId is string) &&
        (!('language' in request.resource.data) ||
          (request.resource.data.language is string && request.resource.data.language.size() <= 8));

      // Lightweight token/language/location update (high-frequency path).
      // Allows the device to keep fcmToken, language, and live geo coordinates
      // in sync without re-validating profile completeness (fullName etc).
      allow update: if isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'language', 'location', 'geohash']) &&
        (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken is string) &&
        (!('language' in request.resource.data) ||
          (request.resource.data.language is string && request.resource.data.language.size() <= 8)) &&
        (!('location' in request.resource.data) || validLatLng(request.resource.data.location)) &&
        (!('geohash' in request.resource.data) || request.resource.data.geohash is string);

      // Full profile update (name, image, location, referral linking).
      // Immutable: phone, createdAt, role. Forbidden from client: isVerified, isActive, ratings, counters, email.
      allow update: if isSelf(userId) &&
        request.resource.data.keys().hasAll([
          'phone', 'fullName', 'role', 'createdAt'
        ]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phone', 'fullName', 'profileImageUrl', 'role',
          'location', 'geohash', 'fcmToken', 'language',
          'createdAt', 'referralCode', 'referredByCode', 'referredByUserId'
        ]) &&
        (!('phone' in resource.data) || request.resource.data.phone == resource.data.phone) &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
        // Single-role architecture: role is immutable once set.
        (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 20 &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 1 && request.resource.data.fullName.size() <= 120 &&
        validRole(request.resource.data.role) &&
        (!('location' in request.resource.data) || validLatLng(request.resource.data.location)) &&
        (!('geohash' in request.resource.data) || request.resource.data.geohash is string) &&
        (!('profileImageUrl' in request.resource.data) || request.resource.data.profileImageUrl is string) &&
        (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken is string) &&
        (!('referralCode' in request.resource.data) || request.resource.data.referralCode is string) &&
        (!('referredByCode' in request.resource.data) || request.resource.data.referredByCode is string) &&
        (!('referredByUserId' in request.resource.data) || request.resource.data.referredByUserId is string) &&
        (!('language' in request.resource.data) ||
          (request.resource.data.language is string && request.resource.data.language.size() <= 8));

      allow delete: if false;
    }

    // ── worker_profiles ───────────────────────────────────────────────
    // Profile-owned fields only. Aggregates (rating, totalRatings, totalJobs) are CF-only.
    // List is closed — clients must use the `searchWorkers` callable to discover workers.
    // NOTE: Employer-side reads of an applicant's worker_profile are intentionally NOT
    // granted here. Rules cannot iterate the applications collection to verify the caller
    // employs this worker. Use a callable CF (`getWorkerProfileForEmployer({jobId, workerId})`)
    // that asserts `exists(applications/{jobId}_{workerId})` && employerId == auth.uid.
    match /worker_profiles/{userId} {
      allow read, write: if isAdmin();

      allow get: if isSelf(userId);
      allow list: if false;

      allow create: if isSelf(userId) &&
        request.resource.data.keys().hasOnly([
          'skills', 'email', 'dateOfBirth', 'gender', 'experience', 'profileImageUrl', 'isAvailable'
        ]) &&
        (!('skills' in request.resource.data) || (request.resource.data.skills is list && request.resource.data.skills.size() <= 30)) &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120)) &&
        (!('dateOfBirth' in request.resource.data) || (request.resource.data.dateOfBirth is string && request.resource.data.dateOfBirth.size() <= 20)) &&
        (!('gender' in request.resource.data) || (request.resource.data.gender is string && request.resource.data.gender.size() <= 20)) &&
        (!('experience' in request.resource.data) || (request.resource.data.experience is string && request.resource.data.experience.size() <= 500)) &&
        (!('profileImageUrl' in request.resource.data) || request.resource.data.profileImageUrl is string) &&
        (!('isAvailable' in request.resource.data) || request.resource.data.isAvailable is bool);

      allow update: if isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'skills', 'email', 'dateOfBirth', 'gender', 'experience', 'profileImageUrl', 'isAvailable'
        ]) &&
        (!('skills' in request.resource.data) || (request.resource.data.skills is list && request.resource.data.skills.size() <= 30)) &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120)) &&
        (!('dateOfBirth' in request.resource.data) || (request.resource.data.dateOfBirth is string && request.resource.data.dateOfBirth.size() <= 20)) &&
        (!('gender' in request.resource.data) || (request.resource.data.gender is string && request.resource.data.gender.size() <= 20)) &&
        (!('experience' in request.resource.data) || (request.resource.data.experience is string && request.resource.data.experience.size() <= 500)) &&
        (!('profileImageUrl' in request.resource.data) || request.resource.data.profileImageUrl is string) &&
        (!('isAvailable' in request.resource.data) || request.resource.data.isAvailable is bool);

      allow delete: if isSelf(userId);
    }

    // ── employer_profiles ─────────────────────────────────────────────
    // Profile-owned fields only. Aggregates (rating, totalRatings, totalHires, isVerified) are CF-only.
    match /employer_profiles/{userId} {
      allow read, write: if isAdmin();

      allow get: if isSelf(userId);
      allow list: if false;

      allow create: if isSelf(userId) &&
        request.resource.data.keys().hasOnly([
          'companyName', 'email', 'profileImageUrl', 'gstNumber',
          'industry', 'companySize', 'businessAddress'
        ]) &&
        request.resource.data.keys().hasAll(['companyName']) &&
        request.resource.data.companyName is string &&
        request.resource.data.companyName.size() >= 1 && request.resource.data.companyName.size() <= 120 &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120)) &&
        (!('profileImageUrl' in request.resource.data) || request.resource.data.profileImageUrl is string) &&
        (!('gstNumber' in request.resource.data) || request.resource.data.gstNumber is string) &&
        (!('industry' in request.resource.data) || (request.resource.data.industry is string && request.resource.data.industry.size() <= 120)) &&
        (!('companySize' in request.resource.data) || (request.resource.data.companySize is string && request.resource.data.companySize.size() <= 64)) &&
        (!('businessAddress' in request.resource.data) || (request.resource.data.businessAddress is string && request.resource.data.businessAddress.size() <= 500));

      allow update: if isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'companyName', 'email', 'profileImageUrl', 'gstNumber',
          'industry', 'companySize', 'businessAddress'
        ]) &&
        (!('companyName' in request.resource.data) || (request.resource.data.companyName is string && request.resource.data.companyName.size() <= 120)) &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120)) &&
        (!('profileImageUrl' in request.resource.data) || request.resource.data.profileImageUrl is string) &&
        (!('gstNumber' in request.resource.data) || request.resource.data.gstNumber is string) &&
        (!('industry' in request.resource.data) || (request.resource.data.industry is string && request.resource.data.industry.size() <= 120)) &&
        (!('companySize' in request.resource.data) || (request.resource.data.companySize is string && request.resource.data.companySize.size() <= 64)) &&
        (!('businessAddress' in request.resource.data) || (request.resource.data.businessAddress is string && request.resource.data.businessAddress.size() <= 500));

      allow delete: if isSelf(userId);
    }

    // ── jobmetadata ────────────────────────────────────────────────────
    // Public card-list payload. Tiny. employerId + expiresAt live in job_details.
    match /jobmetadata/{jobId} {
      allow read, write: if isAdmin();

      allow get, list: if true;

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'companyName', 'title', 'jobType',
          'salary', 'salaryType', 'location', 'geohash', 'addressText', 'companyCity',
          'urgency', 'status', 'createdAt', 'employerId',
          // #5 fix: optional hero image URL stored on the slim card payload
          // so worker/employer job lists can render it without an extra read.
          'jobImageUrl',
          // Apr 2026: vacancies mirrored on jobmetadata so list views
          // (employer home, history) can show real position counts without
          // an extra job_details fetch.
          'vacancies',
          // Apr 2026 fast-path: rich display fields mirrored on jobmetadata
          // so the worker job-description screen renders fully on the
          // first round-trip (no second job_details fetch needed). These
          // remain non-sensitive; contactNumber + applicationCount stay
          // private in job_details.
          'description', 'benefits', 'shiftTiming', 'gender', 'experienceRequired'
        ]) &&
        request.resource.data.keys().hasAll([
          'companyName', 'title', 'jobType',
          'salary', 'salaryType', 'location', 'geohash', 'addressText',
          'urgency', 'status', 'createdAt', 'employerId'
        ]) &&
        // Ownership is enforced via the sibling job_details doc created in the same batch.
        existsAfter(/databases/$(database)/documents/job_details/$(jobId)) &&
        getAfter(/databases/$(database)/documents/job_details/$(jobId)).data.employerId == request.auth.uid &&
        // BUG #14 FIX: jobmetadata also carries employerId so the employer's
        // own posted-jobs query (whereEqualTo("employerId", uid)) returns rows.
        // It must equal the authenticated UID and the sibling job_details doc.
        request.resource.data.employerId is string &&
        request.resource.data.employerId == request.auth.uid &&
        request.resource.data.companyName is string &&
        request.resource.data.companyName.size() <= 120 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120 &&
        request.resource.data.jobType is string &&
        request.resource.data.salary is string &&
        request.resource.data.salary.size() >= 1 && request.resource.data.salary.size() <= 60 &&
        request.resource.data.salaryType is string &&
        validLatLng(request.resource.data.location) &&
        request.resource.data.geohash is string &&
        request.resource.data.addressText is string &&
        request.resource.data.addressText.size() <= 300 &&
        (!('companyCity' in request.resource.data) || (request.resource.data.companyCity is string && request.resource.data.companyCity.size() <= 120)) &&
        request.resource.data.urgency in ['LOW', 'MEDIUM', 'HIGH'] &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt is timestamp &&
        (!('jobImageUrl' in request.resource.data) || (request.resource.data.jobImageUrl is string && request.resource.data.jobImageUrl.size() <= 1024)) &&
        (!('vacancies' in request.resource.data) || (request.resource.data.vacancies is int && request.resource.data.vacancies >= 1 && request.resource.data.vacancies <= 1000)) &&
        (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 5000)) &&
        (!('benefits' in request.resource.data) || (request.resource.data.benefits is list && request.resource.data.benefits.size() <= 20)) &&
        (!('shiftTiming' in request.resource.data) || (request.resource.data.shiftTiming is string && request.resource.data.shiftTiming.size() <= 120)) &&
        (!('gender' in request.resource.data) || (request.resource.data.gender is string && request.resource.data.gender.size() <= 30)) &&
        (!('experienceRequired' in request.resource.data) || (request.resource.data.experienceRequired is string && request.resource.data.experienceRequired.size() <= 200));

      allow update: if isSignedIn() &&
        exists(/databases/$(database)/documents/job_details/$(jobId)) &&
        get(/databases/$(database)/documents/job_details/$(jobId)).data.employerId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'companyName', 'title', 'jobType',
          'salary', 'salaryType', 'location', 'geohash', 'addressText', 'companyCity',
          'urgency', 'status', 'createdAt', 'employerId',
          'jobImageUrl',
          'vacancies',
          'description', 'benefits', 'shiftTiming', 'gender', 'experienceRequired'
        ]) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        // BUG #14 FIX: employerId is now part of the card schema. New writes
        // must set it to the authenticated UID; legacy docs (created before
        // this field existed) are allowed to add it on first edit.
        (!('employerId' in request.resource.data) ||
          (request.resource.data.employerId is string &&
           request.resource.data.employerId == request.auth.uid)) &&
        request.resource.data.companyName is string && request.resource.data.companyName.size() <= 120 &&
        request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120 &&
        request.resource.data.jobType is string &&
        request.resource.data.salary is string && request.resource.data.salary.size() >= 1 && request.resource.data.salary.size() <= 60 &&
        request.resource.data.salaryType is string &&
        validLatLng(request.resource.data.location) &&
        request.resource.data.geohash is string &&
        request.resource.data.addressText is string && request.resource.data.addressText.size() <= 300 &&
        (!('companyCity' in request.resource.data) || (request.resource.data.companyCity is string && request.resource.data.companyCity.size() <= 120)) &&
        request.resource.data.urgency in ['LOW', 'MEDIUM', 'HIGH'] &&
        request.resource.data.status in ['open', 'closed', 'expired'] &&
        (!('jobImageUrl' in request.resource.data) || (request.resource.data.jobImageUrl is string && request.resource.data.jobImageUrl.size() <= 1024)) &&
        (!('vacancies' in request.resource.data) || (request.resource.data.vacancies is int && request.resource.data.vacancies >= 1 && request.resource.data.vacancies <= 1000)) &&
        (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 5000)) &&
        (!('benefits' in request.resource.data) || (request.resource.data.benefits is list && request.resource.data.benefits.size() <= 20)) &&
        (!('shiftTiming' in request.resource.data) || (request.resource.data.shiftTiming is string && request.resource.data.shiftTiming.size() <= 120)) &&
        (!('gender' in request.resource.data) || (request.resource.data.gender is string && request.resource.data.gender.size() <= 30)) &&
        (!('experienceRequired' in request.resource.data) || (request.resource.data.experienceRequired is string && request.resource.data.experienceRequired.size() <= 200));

      allow delete: if isSignedIn() &&
        exists(/databases/$(database)/documents/job_details/$(jobId)) &&
        get(/databases/$(database)/documents/job_details/$(jobId)).data.employerId == request.auth.uid;
    }

    // ── employer_job_cards ────────────────────────────
    // Bug #4 fix: dedicated denormalized doc per job for the employer's
    // home/list cards. Maintained exclusively by Cloud Functions
    // (employer-cards.ts) so clients have read-only visibility.
    match /employer_job_cards/{jobId} {
      allow read, write: if isAdmin();
      allow get, list: if isSignedIn() && resource.data.employerId == request.auth.uid;
      // Writes are CF-only via the admin SDK; deny all client writes.
      allow create, update, delete: if false;
    }

    // ── job_details ────────────────────────────────────────────────────
    // Private, auth-required. Holds employerId, expiresAt and rich fields
    // not present in the slim public jobmetadata card.
    match /job_details/{jobId} {
      allow read, write: if isAdmin();

      // Public single-doc reads so guests can see the full job description
      // (description, benefits, shiftTiming, gender, experience, vacancies,
      // contactNumber). Listing is still blocked — workers must arrive via
      // a known jobId from the public jobmetadata card.
      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'employerId', 'createdAt', 'expiresAt', 'idempotencyKey',
          'description', 'contactNumber', 'whatsappNumber',
          'gender', 'experienceRequired', 'shiftTiming', 'workingHours',
          'vacancies', 'benefits', 'applicationCount'
        ]) &&
        request.resource.data.keys().hasAll([
          'employerId', 'expiresAt', 'description', 'contactNumber', 'vacancies', 'benefits'
        ]) &&
        request.resource.data.employerId == request.auth.uid &&
        request.resource.data.expiresAt is timestamp &&
        (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp) &&
        (!('idempotencyKey' in request.resource.data) || (request.resource.data.idempotencyKey is string && request.resource.data.idempotencyKey.size() >= 8 && request.resource.data.idempotencyKey.size() <= 64)) &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 5000 &&
        request.resource.data.contactNumber is string &&
        request.resource.data.contactNumber.size() <= 20 &&
        request.resource.data.vacancies is int &&
        request.resource.data.vacancies >= 1 && request.resource.data.vacancies <= 1000 &&
        request.resource.data.benefits is list &&
        request.resource.data.benefits.size() <= 20 &&
        (!('applicationCount' in request.resource.data) || (request.resource.data.applicationCount is int && request.resource.data.applicationCount >= 0)) &&
        (!('whatsappNumber' in request.resource.data) || (request.resource.data.whatsappNumber is string && request.resource.data.whatsappNumber.size() <= 20)) &&
        (!('gender' in request.resource.data) || request.resource.data.gender is string) &&
        (!('experienceRequired' in request.resource.data) || request.resource.data.experienceRequired is string) &&
        (!('shiftTiming' in request.resource.data) || request.resource.data.shiftTiming is string) &&
        (!('workingHours' in request.resource.data) || request.resource.data.workingHours is string);

      allow update: if isSignedIn() &&
        resource.data.employerId == request.auth.uid &&
        request.resource.data.employerId == resource.data.employerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description', 'contactNumber', 'whatsappNumber',
          'gender', 'experienceRequired', 'shiftTiming', 'workingHours',
          'vacancies', 'benefits', 'applicationCount', 'expiresAt'
        ]) &&
        (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 5000)) &&
        (!('contactNumber' in request.resource.data) || (request.resource.data.contactNumber is string && request.resource.data.contactNumber.size() <= 20)) &&
        (!('vacancies' in request.resource.data) || (request.resource.data.vacancies is int && request.resource.data.vacancies >= 1 && request.resource.data.vacancies <= 1000)) &&
        (!('benefits' in request.resource.data) || (request.resource.data.benefits is list && request.resource.data.benefits.size() <= 20)) &&
        (!('applicationCount' in request.resource.data) || (request.resource.data.applicationCount is int && request.resource.data.applicationCount >= 0)) &&
        (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is timestamp);

      allow delete: if isSignedIn() && resource.data.employerId == request.auth.uid;
    }

    // ── applications ──────────────────────────────────────────────────
    // Deterministic doc id: {jobId}_{workerId}.
    match /applications/{applicationId} {
      allow read, write: if isAdmin();

      function appDocOwnedByCaller() {
        return applicationId.matches('^.+_' + request.auth.uid + '$');
      }

      allow get: if isSignedIn() &&
        (
          (resource != null && (resource.data.workerId == request.auth.uid || resource.data.employerId == request.auth.uid)) ||
          (resource == null && appDocOwnedByCaller())
        );

      allow list: if isSignedIn() &&
        (resource.data.workerId == request.auth.uid || resource.data.employerId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'jobId', 'workerId', 'employerId', 'status', 'createdAt',
          // Bug #18 / #19 fix: optional denormalized snapshot so the
          // employer can render applicant cards without a worker_profiles
          // read (which is owner-only). Worker writes these from their
          // own users + worker_profiles docs at apply time.
          'workerName', 'workerPhone', 'workerEmail', 'workerProfileImageUrl', 'workerSkills',
          'jobTitle', 'companyName', 'jobLocation',
          // Quick-call: denormalized employer contact phone copied from
          // job_details.contactNumber so workers can dial directly from
          // the MyJobs card without reading employer_profiles.
          'employerPhone'
        ]) &&
        request.resource.data.keys().hasAll(['jobId', 'workerId', 'employerId', 'status', 'createdAt']) &&
        request.resource.data.workerId == request.auth.uid &&
        request.resource.data.jobId is string &&
        request.resource.data.employerId is string &&
        request.resource.data.status == 'applied' &&
        request.resource.data.createdAt is timestamp &&
        applicationId == (request.resource.data.jobId + '_' + request.resource.data.workerId) &&
        (!('workerName' in request.resource.data) || (request.resource.data.workerName is string && request.resource.data.workerName.size() <= 120)) &&
        (!('workerPhone' in request.resource.data) || (request.resource.data.workerPhone is string && request.resource.data.workerPhone.size() <= 20)) &&
        (!('workerEmail' in request.resource.data) || (request.resource.data.workerEmail is string && request.resource.data.workerEmail.size() <= 200)) &&
        (!('workerProfileImageUrl' in request.resource.data) || (request.resource.data.workerProfileImageUrl is string && request.resource.data.workerProfileImageUrl.size() <= 1024)) &&
        (!('workerSkills' in request.resource.data) || (request.resource.data.workerSkills is list && request.resource.data.workerSkills.size() <= 20)) &&
        (!('jobTitle' in request.resource.data) || (request.resource.data.jobTitle is string && request.resource.data.jobTitle.size() <= 200)) &&
        (!('companyName' in request.resource.data) || (request.resource.data.companyName is string && request.resource.data.companyName.size() <= 200)) &&
        (!('jobLocation' in request.resource.data) || (request.resource.data.jobLocation is string && request.resource.data.jobLocation.size() <= 200)) &&
        (!('employerPhone' in request.resource.data) || (request.resource.data.employerPhone is string && request.resource.data.employerPhone.size() <= 20)) &&
        exists(/databases/$(database)/documents/jobmetadata/$(request.resource.data.jobId)) &&
        exists(/databases/$(database)/documents/job_details/$(request.resource.data.jobId)) &&
        get(/databases/$(database)/documents/job_details/$(request.resource.data.jobId)).data.employerId == request.resource.data.employerId;

      // STATE MACHINE: only status can change, and only along legal transitions.
      //   applied      → shortlisted | rejected | hired   (employer)
      //   applied      → rejected (worker withdraw)
      //   shortlisted  → rejected | hired                  (employer)
      //   shortlisted  → rejected (worker withdraw)
      //   hired        → completed                          (employer, Bug #15)
      //   completed    → (terminal, immutable)
      //   rejected     → (terminal, immutable)
      // This blocks illegal moves like hired→rejected and worker self-promoting to hired/completed.
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        resource.data.status in ['applied', 'shortlisted', 'hired'] &&
        (
          (
            resource.data.workerId == request.auth.uid &&
            request.resource.data.status == 'rejected' &&
            resource.data.status in ['applied', 'shortlisted']
          ) ||
          (
            resource.data.employerId == request.auth.uid &&
            (
              (resource.data.status == 'applied' &&
                 request.resource.data.status in ['shortlisted', 'rejected', 'hired']) ||
              (resource.data.status == 'shortlisted' &&
                 request.resource.data.status in ['rejected', 'hired']) ||
              (resource.data.status == 'hired' &&
                 request.resource.data.status == 'completed')
            )
          )
        );

      allow delete: if false;
    }

    // ── saved_jobs ────────────────────────────────────────────────────
    // Canonical schema: userId + jobId + createdAt. Doc ID = {userId}_{jobId}.
    match /saved_jobs/{saveId} {
      function saveIdOwnedByCaller() {
        return saveId.matches('^' + request.auth.uid + '_.*$');
      }

      allow get: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || saveIdOwnedByCaller());
      // List closed: client should query with where('userId','==',uid) — but list rule would need per-doc check.
      // Allow list only if ownership is guaranteed by the doc id prefix.
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['userId', 'jobId', 'createdAt']) &&
        request.resource.data.keys().hasAll(['userId', 'jobId', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.jobId is string &&
        request.resource.data.createdAt is timestamp &&
        saveIdOwnedByCaller() &&
        saveId == (request.resource.data.userId + '_' + request.resource.data.jobId);

      allow delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || saveIdOwnedByCaller());
      allow update: if false;
    }

    // ── ratings ───────────────────────────────────────────────────────
    // Deterministic doc id: {jobId}_{fromUserId}. One rating per (job, author).
    // Must be tied to a HIRED application between from↔to on that job.
    match /ratings/{ratingId} {
      function ratingIdOwnedByCaller() {
        return ratingId.matches('^.+_' + request.auth.uid + '$');
      }

      allow get: if isSignedIn() &&
        (
          (resource != null &&
            (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid)) ||
          (resource == null && ratingIdOwnedByCaller())
        );
      allow list: if isSignedIn() &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['jobId', 'fromUserId', 'toUserId', 'rating', 'review', 'createdAt']) &&
        request.resource.data.keys().hasAll(['jobId', 'fromUserId', 'toUserId', 'rating', 'createdAt']) &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.fromUserId != request.resource.data.toUserId &&
        ratingId == (request.resource.data.jobId + '_' + request.resource.data.fromUserId) &&
        request.resource.data.jobId is string &&
        request.resource.data.toUserId is string &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.createdAt is timestamp &&
        (!('review' in request.resource.data) ||
          (request.resource.data.review is string && request.resource.data.review.size() <= 1000)) &&
        // Must be linked to a real hired application (either direction).
        (
          (
            exists(/databases/$(database)/documents/applications/$(request.resource.data.jobId + '_' + request.resource.data.fromUserId)) &&
            get(/databases/$(database)/documents/applications/$(request.resource.data.jobId + '_' + request.resource.data.fromUserId)).data.status == 'hired' &&
            get(/databases/$(database)/documents/applications/$(request.resource.data.jobId + '_' + request.resource.data.fromUserId)).data.employerId == request.resource.data.toUserId
          ) ||
          (
            exists(/databases/$(database)/documents/applications/$(request.resource.data.jobId + '_' + request.resource.data.toUserId)) &&
            get(/databases/$(database)/documents/applications/$(request.resource.data.jobId + '_' + request.resource.data.toUserId)).data.status == 'hired' &&
            get(/databases/$(database)/documents/applications/$(request.resource.data.jobId + '_' + request.resource.data.toUserId)).data.workerId == request.resource.data.toUserId &&
            get(/databases/$(database)/documents/applications/$(request.resource.data.jobId + '_' + request.resource.data.toUserId)).data.employerId == request.resource.data.fromUserId
          )
        );

      allow update, delete: if false;
    }

    // ── job_reports ───────────────────────────────────────────────────
    // Deterministic doc id: {reporterId}_{jobId}. One report per (user, job).
    match /job_reports/{reportId} {
      function reportIdOwnedByCaller() {
        return reportId.matches('^' + request.auth.uid + '_.+$');
      }

      allow get: if isSignedIn() &&
        (
          (resource != null && resource.data.reporterId == request.auth.uid) ||
          (resource == null && reportIdOwnedByCaller())
        );
      allow list: if false;

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'jobId', 'reporterId', 'reportType', 'description', 'createdAt', 'status'
        ]) &&
        request.resource.data.keys().hasAll([
          'jobId', 'reporterId', 'reportType', 'description', 'createdAt', 'status'
        ]) &&
        reportId == (request.auth.uid + '_' + request.resource.data.jobId) &&
        request.resource.data.jobId is string &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reportType in ['SCAM', 'FAKE', 'INAPPROPRIATE', 'DUPLICATE', 'MISLEADING', 'HARASSMENT', 'SPAM', 'OTHER'] &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 1 && request.resource.data.description.size() <= 1000 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.status == 'PENDING' &&
        exists(/databases/$(database)/documents/jobmetadata/$(request.resource.data.jobId));

      allow update, delete: if false;
    }

    // ── referrals ─────────────────────────────────────────────────────
    // Rewards are server-derived; no money fields client-writable.
    match /referrals/{referralId} {
      allow read, write: if isAdmin();

      allow get: if isSignedIn() &&
        (resource.data.referrerId == request.auth.uid || resource.data.referredUserId == request.auth.uid);
      allow list: if isSignedIn() &&
        (resource.data.referrerId == request.auth.uid || resource.data.referredUserId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'referrerId', 'referredUserId', 'referralCode', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'referrerId', 'referredUserId', 'status', 'createdAt'
        ]) &&
        request.resource.data.referredUserId == request.auth.uid &&
        referralId == (request.resource.data.referrerId + '_' + request.resource.data.referredUserId) &&
        request.resource.data.referrerId is string &&
        request.resource.data.referrerId != request.resource.data.referredUserId &&
        request.resource.data.referredUserId is string &&
        request.resource.data.status == 'PENDING' &&
        (!('referralCode' in request.resource.data) ||
          (request.resource.data.referralCode is string && request.resource.data.referralCode.size() <= 10)) &&
        request.resource.data.createdAt is timestamp;

      allow update, delete: if false;
    }

    // ── referral_stats ────────────────────────────────────────────────
    // Cloud Functions only.
    match /referral_stats/{userId} {
      allow read, write: if isAdmin();

      allow get: if isSelf(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ── referral_codes ────────────────────────────────────────────────
    // Read allowed by deterministic code match. Creation is CF-only (derives userName
    // from the authenticated user record to prevent brand impersonation).
    match /referral_codes/{code} {
      allow read, write: if isAdmin();

      allow get: if code.matches('^[A-Za-z0-9]{7,10}$') &&
        (resource == null || resource.data.isActive == true);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ── users/{userId}/withdrawals (read-only; CF writes) ─────────────
    match /users/{userId}/withdrawals/{withdrawalId} {
      allow get, list: if isSelf(userId);
      allow create, update, delete: if false;
    }

    // ── announcements ─────────────────────────────────────────────────
    // Public read, admin-only write via Admin SDK.
    match /announcements/{announcementId} {
      allow read, write: if isAdmin();

      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ── notifications ─────────────────────────────────────────────────
    // CF-only writes. Recipient may only mark read / delete own notifications.
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();

      allow get: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.recipientId == request.auth.uid;

      allow create: if false; // CFs write via Admin SDK

      allow update: if isSignedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.isRead is bool;

      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // ── app_config ────────────────────────────────────────────────────
    // Public read (clients listen to e.g. /app_config/referral for dynamic
    // reward amounts). Writes are CF/admin-only via Admin SDK.
    match /app_config/{doc} {
      allow read, write: if isAdmin();

      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ── deny everything else ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
