rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // ADMIN HELPER FUNCTION
    // ============================================
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    function referralStats(data) {
      return data.get('referralStats', null) is map ? data.referralStats : {};
    }

    function safeReferralStatsUpdate(before, after) {
      let previous = referralStats(before);
      let next = referralStats(after);
      return next.diff(previous).affectedKeys().hasOnly(['lastUpdated', 'freeJobPostings']) &&
             next.get('freeJobPostings', 0) is number &&
             next.get('freeJobPostings', 0) >= 0 &&
             next.get('freeJobPostings', 0) <= previous.get('freeJobPostings', 0);
    }
    
    // ============================================
    // USERS COLLECTION - SECURED (P0 FIX #1) + DUAL-ROLE SUPPORT
    // OPTIMIZED: Now includes savedJobs, appliedJobs arrays, fcmToken
    // ============================================
    // FIXED: Previously had "allow read: if true" which exposed ALL user data
    // NOW: Only owner can read full profile, limited phone lookup for role check
    // DUAL-ROLE: Supports both single role and multi-role (roles array + activeRole)
    // DENORMALIZED: Rating summaries, saved jobs, FCM tokens stored here
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      
      // REFERRAL CODE IMMUTABILITY: Once set, referralCode can NEVER be changed by users
      // REFERRAL STATS: Can be updated by owner OR by Cloud Functions (for rewards)
      // DUAL-ROLE: Allow users to update roles array and activeRole
      // RATING SUMMARY: Can be updated by RatingService
      // SAVED JOBS: Can be updated by owner (add/remove saved job IDs)
      // This prevents users from changing their code but allows Cloud Functions to credit rewards
      allow create: if request.auth != null && request.auth.uid == userId &&
               request.resource.data.get('referralStats', null) == null &&
               request.resource.data.get('referralCode', '') in ['', null] &&
                       !('referralCodeCreatedAt' in request.resource.data) &&
                       request.resource.data.get('averageRating', 0) in [0, null] &&
                       request.resource.data.get('totalRatings', 0) in [0, null] &&
                       request.resource.data.get('workerAverageRating', 0) in [0, null] &&
                       request.resource.data.get('workerTotalRatings', 0) in [0, null];
      
      allow update: if request.auth != null && 
                      request.auth.uid == userId &&
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['referralCode', 'referralCodeCreatedAt', 'averageRating', 'totalRatings', 'workerAverageRating', 'workerTotalRatings']) &&
                      safeReferralStatsUpdate(resource.data, request.resource.data) &&
                      // DUAL-ROLE VALIDATION: Ensure roles array is valid
                      // Must have at least one role, max 2 roles (WORKER and/or EMPLOYER)
                      (!('roles' in request.resource.data) || 
                       (request.resource.data.roles is list &&
                        request.resource.data.roles.size() > 0 &&
                        request.resource.data.roles.size() <= 2)) &&
                      // DUAL-ROLE VALIDATION: activeRole must be in roles array
                      (!('activeRole' in request.resource.data) || 
                       !('roles' in request.resource.data) ||
                       request.resource.data.activeRole in request.resource.data.roles ||
                       request.resource.data.activeRole == request.resource.data.role);
      
      // ADMIN OVERRIDE: Admins can update any user (for testing/support)
      allow update: if isAdmin();
      
      // IMPORTANT: Cloud Functions can update referralCode and referralStats without these restrictions
      // Cloud Functions run with admin privileges and bypass these rules
      
      // Subcollection for FCM tokens (optional, for easier querying)
      match /tokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Subcollection for user activity history
      match /activity/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /phone_roles/{phoneNumber} {
      allow read, write: if request.auth != null &&
        request.auth.token.get('phone_number', '') != '' &&
        request.auth.token.phone_number in [phoneNumber, '+91' + phoneNumber, '+' + phoneNumber];
    }
    
    
    // ============================================
    // JOBS COLLECTION
    // ============================================
    match /jobs/{jobId} {
      // Anyone can read jobs (including guests)
      allow read: if true;
      // Employers can manage their own jobs OR admins can manage all jobs
      allow create: if isAdmin() || (request.auth != null &&
        request.auth.uid == request.resource.data.employerId);
      allow update: if isAdmin() || (request.auth != null &&
        request.auth.uid == resource.data.employerId &&
        request.resource.data.employerId == resource.data.employerId);
      allow delete: if isAdmin() || (request.auth != null &&
        request.auth.uid == resource.data.employerId);
      // Workers can update application count
      allow update: if request.auth != null && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicationCount', 'updatedAt', 'lastApplicationAt']);
    }
    
    // ============================================
    // JOB APPLICATIONS - OPTIMIZED
    // ============================================
    // Now includes verification data as nested field (no separate work_verifications collection)
    match /job_applications/{applicationId} {
      function employerStatusUpdateAllowed() {
        let previous = resource.data.status;
        let next = request.resource.data.status;
        return next == previous ||
               (previous == 'PENDING' && next in ['UNDER_REVIEW', 'ACCEPTED', 'REJECTED']) ||
               (previous == 'UNDER_REVIEW' && next in ['ACCEPTED', 'REJECTED']) ||
               (previous == 'ACCEPTED' && next in ['IN_PROGRESS', 'REJECTED']) ||
               (previous == 'IN_PROGRESS' && next == 'COMPLETED');
      }

      function workerUpdateAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (resource.data.status in ['PENDING', 'UNDER_REVIEW'] &&
                request.resource.data.status == 'WITHDRAWN' &&
                changed.hasOnly(['status', 'statusHistory', 'updatedAt', 'active'])) ||
               (resource.data.status == 'ACCEPTED' &&
                request.resource.data.status == 'ACCEPTED' &&
                changed.hasOnly(['verification', 'verificationId', 'verificationCode', 'verificationStatus']) &&
                request.resource.data.verificationStatus == 'PENDING' &&
                request.resource.data.verification.status == 'PENDING' &&
                request.resource.data.verification.applicationId == applicationId &&
                request.resource.data.verification.jobId == resource.data.jobId &&
                request.resource.data.verification.workerId == resource.data.workerId &&
                request.resource.data.verification.employerId == resource.data.employerId &&
                request.resource.data.verification.verificationCode == request.resource.data.verificationCode);
      }

      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.workerId || request.auth.uid == resource.data.employerId || isAdmin());
      
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.workerId &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.employerId == get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.employerId &&
        !request.resource.data.keys().hasAny(['verification', 'verificationCode', 'verificationStatus', 'workStartedAt']);
      allow update: if request.auth != null &&
        ((request.auth.uid == resource.data.employerId && employerStatusUpdateAllowed()) ||
         (request.auth.uid == resource.data.workerId && workerUpdateAllowed())) &&
        request.resource.data.workerId == resource.data.workerId &&
        request.resource.data.employerId == resource.data.employerId &&
        request.resource.data.jobId == resource.data.jobId;
    }
    
    
    
    // ============================================
    // NOTIFICATIONS
    // ============================================
    match /notifications/{notificationId} {
      // Allow reading individual notification if user is the recipient
      allow get: if request.auth != null && 
        request.auth.uid == resource.data.recipientId;
      // Allow listing/querying notifications for authenticated users
      // Security: Query MUST filter by recipientId to only return user's own notifications
      allow list: if request.auth != null && 
        request.auth.uid == resource.data.recipientId;
      allow create: if false;
      allow update: if request.auth != null && request.auth.uid == resource.data.recipientId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.recipientId;
    }
    
    // ============================================
    // ANNOUNCEMENTS COLLECTION - In-app banners
    // ============================================
    match /announcements/{announcementId} {
      // Anyone can read announcements (including guest users)
      allow read: if true;
      // Admins can write
      allow write: if isAdmin();
    }
    
    // ============================================
    // EMPLOYER BLOCKED ATTEMPTS - AI Screening
    // ============================================
    match /employer_blocked_attempts/{attemptId} {
      // Only the employer can read their own blocked attempts
      allow read: if request.auth != null && request.auth.uid == attemptId;
      // Writes from authenticated client (screening service)
      allow write: if request.auth != null;
    }
    
    // ============================================
    // MODERATION QUEUE - Cloud Functions Only
    // ============================================
    match /moderation_queue/{itemId} {
      allow read, write: if false;  // Cloud Functions only (admin SDK)
    }
    
    // ============================================
    // METADATA COLLECTION - App configuration and stats
    // ============================================
    // For platform_stats, feature_flags, category_stats, location_stats, trending, pay_stats
    match /metadata/{docId} {
      // All authenticated users can read metadata (app configuration)
      allow read: if request.auth != null;
      // Only admins can write (via Firebase Console or Cloud Functions)
      allow write: if false;
    }
    
    
    match /app_feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    
    // ============================================
    // NOTIFICATION TRACKING - For deduplication and rate limiting
    // ============================================
    match /notification_tracking/{userId} {
      // Users can read their own tracking data
      allow read: if request.auth != null && request.auth.uid == userId;
      // System (WorkManager) can write tracking data
      allow write: if request.auth != null;
      
      // Subcollection for sent notifications
      match /sent/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null;
      }
    }
    


    // ============================================
    // REFERRAL SYSTEM - ENTERPRISE GRADE FOR 10L+ USERS
    // ============================================
    // Architecture: Event-driven with Cloud Functions
    // All reward calculations happen server-side for security
    
    // Referral codes - O(1) lookup collection (code as document ID)
    match /referral_codes/{code} {
      // CRITICAL: Allow UNAUTHENTICATED reads for registration flow
      // Users need to validate referral codes BEFORE they create an account
      // This is safe because referral_codes only contain: { userId, userName, role, createdAt }
      // No sensitive data is exposed
      allow get: if true;  // Single document read (by code)
      allow list: if true; // Query operations (for validation)
      
      // Allow authenticated users to create their own referral code document
      // This is a client-side fallback when Cloud Functions don't fire
      // SECURITY: userId in document must match the authenticated user
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      // Updates only via Cloud Functions (admin SDK)
      allow update: if false;
      // No deletion allowed
      allow delete: if false;
    }
    
    // SIMPLIFIED: Referral stats are now stored in users collection as nested field
    // No separate referral_stats collection needed
    
    // Referrals - tracks individual referral relationships
    match /referrals/{referralId} {
      // Referrer or referred user can read their referrals
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.referrerUserId ||
         request.auth.uid == resource.data.referredUserId);
      // Referrals are created via Cloud Functions (applyReferralCode)
      // Client cannot directly create referrals EXCEPT admins for testing
      allow create: if isAdmin();
      // Updates only via Cloud Functions
      allow update: if false;
      // Allow listing for history queries
      allow list: if isAdmin();
    }
    
    // CONSOLIDATED: referral_events and referral_clicks have been merged into referrals collection
    // These rules are kept temporarily for backward compatibility but Cloud Functions
    // should be updated to write events/clicks as subcollections of referrals
    
    // ============================================
    // JOB REPORTS - Community Reporting
    // ============================================
    match /job_reports/{reportId} {
      // Authenticated users can create reports
      allow create: if request.auth != null;
      // Users can read their own reports
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.reporterId;
      // Admins can read/update all reports
      allow read, update: if isAdmin();
      // No deletion
      allow delete: if false;
    }

    // ============================================
    // RATINGS & REVIEWS - Dual-role Support
    // ============================================
    match /ratings/{ratingId} {
      // Anyone authenticated can read ratings
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Withdrawal requests
    match /withdrawal_requests/{withdrawalId} {
      // Users can read their own withdrawal requests
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      // Withdrawals are created via Cloud Functions (requestWithdrawal)
      allow create: if false;
      // Admins can update (process withdrawals)
      allow update: if isAdmin();
      // Allow listing for history
      allow list: if isAdmin();
    }
  }
}
