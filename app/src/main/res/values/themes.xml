<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="Theme.DutyPe" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 
            You can customize your theme here.
            For example, defining primary, secondary colors etc.
            Example:
            <item name="colorPrimary">@color/my_light_primary</item> 
        -->
    </style>

    <!-- 
        MODERN SPLASH SCREEN (Android 12+ API)
        Following Google's official recommendations (2024-2026)
        
        Simple, clean branding with app icon
        Used by: WhatsApp, Instagram, LinkedIn, Uber
    -->
    <style name="Theme.DutyPe.Splash" parent="Theme.SplashScreen">
        <!-- Pure black background — matches the Compose AnimatedSplashScreen for a
             seamless hand-off (no flash, no logo). -->
        <item name="windowSplashScreenBackground">#000000</item>

        <!-- Transparent icon: branding is handled by the Compose splash. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>

        <!-- Post-splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.DutyPe</item>

        <!-- Black system bars with light (white) icons so battery / network /
             time stay visible against the black splash background. -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
