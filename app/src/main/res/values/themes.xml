<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="Theme.DutyPe" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 
            You can customize your theme here.
            For example, defining primary, secondary colors etc.
            Example:
            <item name="colorPrimary">@color/my_light_primary</item> 
        -->
    </style>

    <!--
        MODERN SPLASH SCREEN (Android 12+ API)
        Google-recommended (2024-2026). Used by WhatsApp, Instagram, LinkedIn, Uber.

        Design:
          - Solid black background (matches previous branded splash).
          - Branded vector logo rendered centered (~192dp safe zone inside the
            288dp splash canvas).
          - No animation duration — the system fades the splash out
            automatically when the activity's first frame is drawn. This is the
            zero-overhead path: the splash icon is drawn by SystemUI before the
            app process starts, so swapping the drawable does not change the
            cold-start cost or first-frame timing.
          - Splash stays visible until MainActivity calls
            `keepSplashOnScreen = false` (after MainNavGraph determines the
            start destination), so there is no "blank loading" flash.
    -->
    <style name="Theme.DutyPe.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>

        <!-- Branded DutyPe wordmark + monogram, all-vector for crisp rendering. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_branded_logo</item>
        <item name="windowSplashScreenAnimationDuration">0</item>

        <!-- Post-splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.DutyPe</item>

        <!-- Black system bars with light (white) icons so battery / network /
             time stay visible against the black splash background. -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
