<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.DutyPe" parent="Theme.Material3.DayNight.NoActionBar">
        <!--
            You can customize your theme here.
            For example, defining primary, secondary colors etc.
            Example:
            <item name="colorPrimary">@color/my_light_primary</item>
        -->
    </style>

    <!-- Modern splash screen: blue background with the app icon. -->
    <style name="Theme.DutyPe.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_blue</item>
        <item name="postSplashScreenTheme">@style/Theme.DutyPe</item>
        <item name="android:statusBarColor">@color/splash_blue</item>
        <item name="android:navigationBarColor">@color/splash_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
