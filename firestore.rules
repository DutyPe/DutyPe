rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // ADMIN HELPER FUNCTION
    // ============================================
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.email.matches('.*@dutype.com') ||
              request.auth.token.email in ['admin@dutype.com', 'vamsi@dutype.com', 'vamsib298@gmail.com']);
    }
    
    // ============================================
    // USERS COLLECTION - SECURED (P0 FIX #1) + DUAL-ROLE SUPPORT
    // OPTIMIZED: Now includes ratingSummary, savedJobs array, fcmToken
    // ============================================
    // FIXED: Previously had "allow read: if true" which exposed ALL user data
    // NOW: Only owner can read full profile, limited phone lookup for role check
    // DUAL-ROLE: Supports both single role and multi-role (roles array + activeRole)
    // DENORMALIZED: Rating summaries, saved jobs, FCM tokens stored here
    match /users/{userId} {
      // Owner can read/write their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to read other users' PUBLIC fields only
      // This is needed for viewing employer profiles on job cards
      // ADMIN: Allow admins to list all users
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      
      // PHONE NUMBER LOOKUP: Allow unauthenticated users to check if phone exists
      // This is needed for pre-OTP user existence check during registration/login
      // SECURITY: Only allows checking existence, not reading full user data
      allow get: if true;  // Allows single document reads for phone lookup
      
      // CRITICAL FIX: Allow unauthenticated queries by phoneNumber field for registration check
      // This is needed for FirestoreUtils.doesUserExist() during registration
      // SECURITY: Limited to single document queries only (limit <= 1)
      // The client code only checks if documents exist, doesn't read sensitive fields
      allow list: if request.query.limit <= 1;  // Allow phone lookup queries (authenticated or not)
      
      // REFERRAL CODE IMMUTABILITY: Once set, referralCode can NEVER be changed by users
      // REFERRAL STATS: Can be updated by owner OR by Cloud Functions (for rewards)
      // DUAL-ROLE: Allow users to update roles array and activeRole
      // RATING SUMMARY: Can be updated by RatingService
      // SAVED JOBS: Can be updated by owner (add/remove saved job IDs)
      // This prevents users from changing their code but allows Cloud Functions to credit rewards
      allow create: if request.auth != null && request.auth.uid == userId;
      
      allow update: if request.auth != null && 
                      request.auth.uid == userId &&
                      // CRITICAL: Referral code is IMMUTABLE - once set, it can NEVER be changed
                      // If referralCode exists in old document, new document MUST have same value
                      // If referralCode doesn't exist in old document, it can be set (by Cloud Function)
                      // User updates CANNOT change referralCode field at all
                      (!('referralCode' in request.resource.data) || 
                       !('referralCode' in resource.data) ||
                       request.resource.data.referralCode == resource.data.referralCode) &&
                      // Also protect referralCodeCreatedAt timestamp
                      (!('referralCodeCreatedAt' in request.resource.data) || 
                       !('referralCodeCreatedAt' in resource.data) ||
                       request.resource.data.referralCodeCreatedAt == resource.data.referralCodeCreatedAt) &&
                      // DUAL-ROLE VALIDATION: Ensure roles array is valid
                      // Must have at least one role, max 2 roles (WORKER and/or EMPLOYER)
                      (!('roles' in request.resource.data) || 
                       (request.resource.data.roles is list &&
                        request.resource.data.roles.size() > 0 &&
                        request.resource.data.roles.size() <= 2)) &&
                      // DUAL-ROLE VALIDATION: activeRole must be in roles array
                      (!('activeRole' in request.resource.data) || 
                       !('roles' in request.resource.data) ||
                       request.resource.data.activeRole in request.resource.data.roles ||
                       request.resource.data.activeRole == request.resource.data.role);
      
      // ADMIN OVERRIDE: Admins can update any user (for testing/support)
      allow update: if isAdmin();
      
      // IMPORTANT: Cloud Functions can update referralCode and referralStats without these restrictions
      // Cloud Functions run with admin privileges and bypass these rules
      
      // Subcollection for FCM tokens (optional, for easier querying)
      match /tokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Subcollection for user activity history
      match /activity/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Phone roles collection - LIMITED PUBLIC READ for pre-login role check
    // Document ID is the phone number (without +91 prefix)
    // Contains only { role: "WORKER" | "EMPLOYER" } - minimal data exposure
    match /phone_roles/{phoneNumber} {
      allow read: if true;  // Safe: only contains role, no PII
      allow write: if request.auth != null;
    }
    
    // ============================================
    // BLACKLISTS COLLECTION - NEW (P0 FIX #4 & #5)
    // ============================================
    // For phone and device blacklisting
    match /blacklists/{blacklistId} {
      // Anyone can read blacklist to check if banned (needed before auth)
      allow read: if true;
      // Only admins can write (via Firebase Console or Cloud Functions)
      allow write: if false;
    }
    
    // ============================================
    // FRAUD SIGNALS COLLECTION - NEW (P0 FIX #2)
    // ============================================
    // For tracking rate limit violations and suspicious activity
    match /fraud_signals/{signalId} {
      // Only system can read/write (via Cloud Functions)
      allow read, write: if false;
    }
    

    
    // ============================================
    // WORKER PROFILES
    // ============================================
    match /worker_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow querying by email for existing user detection
      allow read: if request.auth != null;
    }
    
    // ============================================
    // EMPLOYER PROFILES
    // ============================================
    match /employer_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow querying by email for existing user detection
      allow read: if request.auth != null;
    }
    
    // ============================================
    // JOBS COLLECTION
    // ============================================
    match /jobs/{jobId} {
      // Anyone can read jobs (including guests)
      allow read: if true;
      // Employers can manage their own jobs OR admins can manage all jobs
      allow write: if isAdmin() || (request.auth != null && 
        (request.auth.uid == resource.data.employerId || 
         request.auth.uid == request.resource.data.employerId));
      // Workers can update application count
      allow update: if request.auth != null && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicationCount', 'updatedAt', 'lastApplicationAt']);
    }
    
    // ============================================
    // JOB APPLICATIONS - OPTIMIZED
    // ============================================
    // Now includes verification data as nested field (no separate work_verifications collection)
    match /job_applications/{applicationId} {
      // Allow unauthenticated reads for PendingApplicationNotificationWorker
      // Worker needs to run as background job without user authentication
      allow read: if true;  // Safe: only contains application data, no sensitive PII
      
      // Authenticated users can read their own applications
      allow read: if request.auth != null && 
        (resource == null || 
         request.auth.uid == resource.data.workerId || 
         request.auth.uid == resource.data.employerId);
      allow write: if request.auth != null && 
        (request.auth.uid == request.resource.data.workerId ||
         request.auth.uid == request.resource.data.employerId);
      allow list: if true;  // Allow listing for background workers
    }
    
    // Applications collection (alternative name used by UserMetadata)
    match /applications/{applicationId} {
      // Allow reading accepted applications for "recently hired" feature (guest users can see)
      allow read: if resource.data.status == 'ACCEPTED';
      // Authenticated users can read their own applications
      allow read: if request.auth != null && 
        (resource == null || 
         request.auth.uid == resource.data.workerId || 
         request.auth.uid == resource.data.employerId);
      allow write: if request.auth != null && 
        (request.auth.uid == request.resource.data.workerId ||
         request.auth.uid == request.resource.data.employerId);
      // List queries require authentication OR status filter for ACCEPTED
      allow list: if request.auth != null || 
        (request.query.limit <= 10 && 
         'status' in request.query && 
         request.query.status == 'ACCEPTED');
    }
    
    // ============================================
    // SAVED JOBS - DEPRECATED (now stored in users.savedJobs array)
    // ============================================
    // Keeping for backward compatibility during migration
    match /saved_jobs/{savedJobId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.workerId || 
         request.auth.uid == request.resource.data.workerId);
      // Allow listing/querying saved jobs for authenticated users
      allow list: if request.auth != null;
    }
    
    // Alternative collection name used by UserMetadata
    match /savedJobs/{savedJobId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.workerId || 
         request.auth.uid == request.resource.data.workerId);
      // Allow listing/querying saved jobs for authenticated users
      allow list: if request.auth != null;
    }
    
    // ============================================
    // NOTIFICATIONS
    // ============================================
    match /notifications/{notificationId} {
      // Allow reading individual notification if user is the recipient
      allow get: if request.auth != null && 
        request.auth.uid == resource.data.recipientId;
      // Allow listing/querying notifications for authenticated users
      // Security: Query MUST filter by recipientId to only return user's own notifications
      allow list: if request.auth != null && 
        request.auth.uid == resource.data.recipientId;
      // Allow creating notifications (for system/other users sending notifications)
      allow create: if request.auth != null;
      // Only recipient can update (mark as read) or delete their notifications
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.recipientId;
    }
    
    // ============================================
    // ANNOUNCEMENTS COLLECTION - In-app banners
    // ============================================
    match /announcements/{announcementId} {
      // Anyone can read announcements (including guest users)
      allow read: if true;
      // Admins can write
      allow write: if isAdmin();
    }
    
    // Dismissed announcements - tracks which users dismissed which announcements
    match /dismissed_announcements/{dismissalId} {
      // Users can read their own dismissals
      allow read: if request.auth != null;
      // Users can create dismissals (dismiss announcements)
      allow create: if request.auth != null;
      // No updates or deletes
      allow update, delete: if false;
    }
    
    // ============================================
    // METADATA COLLECTION - App configuration and stats
    // ============================================
    // For platform_stats, feature_flags, category_stats, location_stats, trending, pay_stats
    match /metadata/{docId} {
      // All authenticated users can read metadata (app configuration)
      allow read: if request.auth != null;
      // Only admins can write (via Firebase Console or Cloud Functions)
      allow write: if false;
    }
    
    // ============================================
    // USER ACTIVITY - DEPRECATED (now stored in users/{id}/activity subcollection)
    // ============================================
    // Keeping for backward compatibility during migration
    match /user_activity/{activityId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == request.resource.data.userId);
    }
    
    match /app_analytics/{document=**} {
      allow write: if request.auth != null;
    }
    
    match /app_feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    // ============================================
    // FCM TOKENS - DEPRECATED (now stored in users.fcmToken and users/{id}/tokens)
    // ============================================
    // Keeping for backward compatibility during migration
    match /fcm_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ============================================
    // RATINGS & RATING SUMMARIES - OPTIMIZED
    // ============================================
    // Rating summaries now stored in users.ratingSummary field (no separate collection)
    match /ratings/{ratingId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.raterUserId;
      allow update, delete: if false;
    }
    
    // DEPRECATED: Rating summaries collection (now in users.ratingSummary)
    // Keeping for backward compatibility during migration
    match /rating_summaries/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // ============================================
    // WORK VERIFICATIONS - DEPRECATED (now stored in applications.verification)
    // ============================================
    // Keeping for backward compatibility during migration
    match /work_verifications/{verificationId} {
      // Workers and employers can read their own verifications
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.workerId || 
         request.auth.uid == resource.data.employerId);
      // Allow listing for authenticated users (needed for queries)
      allow list: if request.auth != null;
      // FIXED: Allow authenticated users to create (service creates on behalf of employer)
      // The service validates the employer owns the job before creating
      allow create: if request.auth != null;
      // Allow both worker and employer to update their verifications
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.workerId || 
         request.auth.uid == resource.data.employerId);
      // No deletion allowed
      allow delete: if false;
    }
    
    // ============================================
    // SUBSCRIPTIONS & PAYMENTS
    // ============================================
    match /subscriptions/{subscriptionId} {
      // Allow users to read their own subscription by userId field
      allow read: if request.auth != null && 
        (request.auth.uid == subscriptionId || 
         request.auth.uid == resource.data.userId);
      allow write: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      // Allow querying subscriptions
      allow list: if request.auth != null;
    }
    
    // ============================================
    // ACHIEVEMENTS
    // ============================================
    match /achievements/{userId} {
      // Users can read their own achievements
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only Cloud Functions can write achievements
      allow write: if false;
    }
    
    // ============================================
    // SUBSCRIPTIONS & PAYMENTS
    // ============================================
    match /subscriptions/{subscriptionId} {
      // Allow users to read their own subscription by userId field
      allow read: if request.auth != null && 
        (request.auth.uid == subscriptionId || 
         request.auth.uid == resource.data.userId);
      allow write: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      // Allow querying subscriptions
      allow list: if request.auth != null;
    }
    

    
    // ============================================
    // USER PREFERENCES
    // ============================================
    match /userPreferences/{userId} {
      // Users can read/write their own preferences
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ============================================
    // APP FEEDBACK
    // ============================================
    match /app_feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    // ============================================
    // NOTIFICATION TRACKING - For deduplication and rate limiting
    // ============================================
    match /notification_tracking/{userId} {
      // Users can read their own tracking data
      allow read: if request.auth != null && request.auth.uid == userId;
      // System (WorkManager) can write tracking data
      allow write: if request.auth != null;
      
      // Subcollection for sent notifications
      match /sent/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null;
      }
    }
    

    
    // ============================================
    // P1: REAL-TIME CHAT - CONVERSATIONS
    // ============================================
    match /conversations/{conversationId} {
      // Participants can read their conversations
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      // Only Cloud Functions can create/update
      allow create, update: if false;
    }
    
    // ============================================
    // P1: REAL-TIME CHAT - MESSAGES
    // ============================================
    match /messages/{messageId} {
      // Sender or recipient can read
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.senderId || 
         request.auth.uid == resource.data.recipientId);
      // Only Cloud Functions can create
      allow create: if false;
      // Recipient can mark as read
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.recipientId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
    }
    
    // ============================================
    // REFERRAL SYSTEM - ENTERPRISE GRADE FOR 10L+ USERS
    // ============================================
    // Architecture: Event-driven with Cloud Functions
    // All reward calculations happen server-side for security
    
    // Referral codes - O(1) lookup collection (code as document ID)
    match /referral_codes/{code} {
      // CRITICAL: Allow UNAUTHENTICATED reads for registration flow
      // Users need to validate referral codes BEFORE they create an account
      // This is safe because referral_codes only contain: { userId, userName, role, createdAt }
      // No sensitive data is exposed
      allow get: if true;  // Single document read (by code)
      allow list: if true; // Query operations (for validation)
      
      // SECURITY: Only Cloud Functions can create/update codes (server-side only)
      // This prevents client-side manipulation of referral codes
      allow create, update: if false;
      // No deletion allowed
      allow delete: if false;
    }
    
    // SIMPLIFIED: Referral stats are now stored in users collection as nested field
    // No separate referral_stats collection needed
    
    // Referrals - tracks individual referral relationships
    match /referrals/{referralId} {
      // Referrer or referred user can read their referrals
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.referrerUserId ||
         request.auth.uid == resource.data.referredUserId);
      // Referrals are created via Cloud Functions (applyReferralCode)
      // Client cannot directly create referrals EXCEPT admins for testing
      allow create: if isAdmin();
      // Updates only via Cloud Functions
      allow update: if false;
      // Allow listing for history queries
      allow list: if request.auth != null;
    }
    
    // Referral events - audit trail (read-only for users)
    match /referral_events/{eventId} {
      // Users can read their own events
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      // Only Cloud Functions can write
      allow write: if false;
    }
    
    // Referral clicks - for analytics tracking
    match /referral_clicks/{clickId} {
      // Users can read their own clicks
      allow read: if request.auth != null;
      // Cloud Functions can create clicks
      allow create: if false;
      // No updates or deletes
      allow update, delete: if false;
    }
    
    // Withdrawal requests
    match /withdrawal_requests/{withdrawalId} {
      // Users can read their own withdrawal requests
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      // Withdrawals are created via Cloud Functions (requestWithdrawal)
      allow create: if false;
      // Admins can update (process withdrawals)
      allow update: if isAdmin();
      // Allow listing for history
      allow list: if request.auth != null;
    }
  }
}
