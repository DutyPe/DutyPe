rules_version = '2';
// ──────────────────────────────────────────────────────────────────────────
// DutyPe Storage Security Rules — owner-scoped with size + content-type caps.
// PII resumes/cover letters are NOT readable by arbitrary signed-in users.
// Employers obtain short-lived signed URLs through a CF that validates an
// existing application between employer and worker.
// ──────────────────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.get('admin', false) == true) ||
        (request.auth.token.get('role', '') == 'ADMIN') ||
        (request.auth.token.get('activeRole', '') == 'ADMIN') ||
        (request.auth.token.get('email', '') is string &&
          (
            request.auth.token.email.lower().matches('.*@dutype\\.com$') ||
            request.auth.token.email.lower() in [
              'admin@dutype.com',
              'vamsi@dutype.com',
              'vamsib298@gmail.com',
              'dutpyein@gmail.com'
            ]
          )
        )
      );
    }


    // Profile images — public read (displayed in job cards), owner-only write.
    // 5 MB cap, image content types only.
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Job images — public read, employer-only write.
    match /job_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Cover letters — owner-only direct access. Employers must use the
    // `getCoverLetterSignedUrl` callable which validates an active application.
    // 10 MB cap, PDF only.
    match /cover_letters/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Active payment QR codes — public read (workers/employers scan to pay), auth write/delete.
    match /active_qrs/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }

    // Dynamic configuration assets (banners, lottie) — public read, admin-only write.
    match /dynamic_assets/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
